---
// sow-207: the post-signup welcome flow on gbti.network. A signed-in member (fresh from signup, including a
// Codeable coupon invitee) lands here and walks the shared <gbti-welcome> wizard: connect Discord, follow the
// network channels, add their socials, follow members, and pick topics. The wizard is the SAME client-ui
// component the extension uses (client-ui/src/elements/gbti-welcome.mjs), wired to the cookie-session adapter
// (src/lib/workbench-client) so no GitHub token is in the page. Signed-out visitors get the sign-in prompt.
// noindex: a private, per-member surface. Mount pattern mirrors src/pages/account.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Welcome" description="Welcome to the GBTI Network. Finish setting up your membership." noindex={true}>
  <section class="band">
    <div class="wrap wel-wrap">
      {/* Signed-OUT fallback (also the pre-hydration state; static SSG has no request-time cookie). */}
      <div class="sec-head center" data-welcome-signedout>
        <span class="itile"><svg viewBox="0 0 24 24"><use href="#ico-id"/></svg></span>
        <h1 class="h1 mt24">Welcome to the GBTI Network</h1>
        <p class="lead">
          Sign in with GitHub to finish setting up your membership: join the community on Discord, follow
          members and channels, add your socials, and pick the topics you want in your feed.
        </p>
        <a href="/login/?return_to=%2Fwelcome%2F" class="btn btn-primary btn-lg mt24">Sign in <svg class="ar" viewBox="0 0 24 24" width="18" height="18"><use href="#ico-arrow"/></svg></a>
      </div>

      {/* Signed-IN welcome wizard, hydrated client-side from the httpOnly-cookie session (member-signal.ts). */}
      <div data-welcome-signedin hidden>
        <div data-welcome-mount>
          <p class="wel-load">Loading your welcome&hellip;</p>
          <gbti-welcome></gbti-welcome>
        </div>
        <p class="wel-skip"><a href="/account/">Skip for now, go to my account</a></p>
      </div>
    </div>
  </section>

  <script>
    import { onMemberSignal, currentIdentity, readMemberSignal } from '../lib/member-signal';

    const out = document.querySelector('[data-welcome-signedout]') as HTMLElement | null;
    const inn = document.querySelector('[data-welcome-signedin]') as HTMLElement | null;

    let mounted = false; // the client-ui wizard loads once, on the first signed-in signal

    function render(s: any) {
      const signedIn = !!(s && s.login);
      if (out) out.hidden = signedIn;
      if (inn) inn.hidden = !signedIn;
      if (signedIn) mountWelcome(s);
    }

    async function mountWelcome(s: any) {
      if (mounted) return;
      mounted = true;
      const signupBase = document.documentElement.dataset.signupBase || '';
      // Set the client BEFORE defining the element, so <gbti-welcome>'s connectedCallback -> load() sees it
      // (avoids the client-ready race; the same ordering account.astro uses).
      const { createWorkbenchClient } = await import('../lib/workbench-client');
      const { setClient } = await import('../../client-ui/src/base.mjs');
      const adapter = createWorkbenchClient({ signupBase, login: String(s.login), githubId: s.githubId != null ? String(s.githubId) : null });
      setClient(adapter);
      document.querySelectorAll('.wel-load').forEach((el) => el.setAttribute('hidden', ''));
      // Defining the element upgrades the static tag; it renders on the setClient subscriber fan-out.
      await import('../../client-ui/src/elements/gbti-welcome.mjs');
      // When the member finishes the wizard, land on the account hub (the website member surface, sow-158).
      document.querySelector('gbti-welcome')?.addEventListener('gbti:welcome-done', () => {
        window.location.href = '/account/';
      });
    }

    render(currentIdentity(readMemberSignal()));
    onMemberSignal(render); // BaseLayout invokes hydrateMemberSignal(); the cookie member arrives here
  </script>

  <style>
    .wel-wrap { max-width: 1040px; }
    .wel-load { color: var(--fg-mute); font-size: 14px; }
    .wel-load[hidden] { display: none; }
    .wel-skip { text-align: center; margin-top: 28px; font-size: 13.5px; }
    .wel-skip a { color: var(--fg-mute); }
    .wel-skip a:hover { color: var(--brand); }
  </style>
</BaseLayout>
