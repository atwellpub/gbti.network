---
// sow-094 (owner-directed, 2026-07-21): the public share's own deep-linked expanded view, mirroring
// the extension's share reader. PUBLIC shares ONLY (published + visibility:public, the fail-closed
// isPublicShare); a members-only or draft share gets NO page (the check-build-secrets guard proves
// dist/shares/ carries nothing else). The page leads with the external "Read on <domain>" CTA
// (noopener nofollow) and mounts the member discussion, which renders GATED (share comments are
// always members-only + encrypted, SOW-044; visitors see locked placeholders + the join nudge).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Avatar from '../../../components/Avatar.astro';
import FavoriteButton from '../../../components/FavoriteButton.astro';
import CollectionButton from '../../../components/CollectionButton.astro';
import SubscribeButton from '../../../components/SubscribeButton.astro';
import Comments from '../../../components/blog/Comments.astro';
import VideoEmbed from '../../../components/VideoEmbed.astro';
import { embedUrl } from '../../../../client/src/video-embed.mjs';
import { getCollection } from 'astro:content';
import { authorDisplay, authorHref, formatDate, authorAvatar } from '../../../lib/authors';
import { isPublicShare, decodeEntities, utmUrl } from '../../../lib/home-feed.mjs';
import { favoriteCount } from '../../../lib/favorites';

export async function getStaticPaths() {
  const shares = (await getCollection('share')).filter((s) => isPublicShare(s.data));
  return shares.map((s) => ({ params: { author: s.data.author, id: s.data.id }, props: { share: s } }));
}

const { share } = Astro.props;
const d = share.data;
const slug = `${d.author}/${d.id}`;
const title = decodeEntities(d.title ?? d.shortDescription ?? 'A member share');
const desc = d.title && d.shortDescription ? decodeEntities(d.shortDescription) : undefined;
// The summary is scraped from the article source (owner QA 2026-07-22): render it QUOTED, append an
// ellipsis when the scrape cut mid-sentence, and reference the footnote under the read CTA.
const descComplete = desc ? /[.!?]["')\]]?$/.test(desc.trim()) : true;
const quotedDesc = desc ? `"${desc.trim()}${descComplete ? '' : '...'}"` : undefined;
let srcDomain: string | undefined;
try { srcDomain = d.url ? new URL(d.url).hostname.replace(/^www\./, '') : undefined; } catch { srcDomain = undefined; }
const profiles = await getCollection('profile');
const profile = profiles.find((p) => p.data.username === d.author);
const avatar = authorAvatar(d.author, profile?.data.avatar);
const headline = profile?.data.headline;
const body = (share.rendered?.html ?? '').trim();
// sow-145: every outbound click-through carries the UTM attribution for the source publication.
const outUrl = d.url ? utmUrl(d.url, { campaign: 'shares' }) : undefined;
// A share pointing at a recognized video (YouTube/Vimeo/TikTok/Rumble) PLAYS INLINE, matching what the
// extension share views have done since SOW-092: the player replaces the static share image, which for a
// video link is just that video's thumbnail anyway. Unrecognized links keep the image + read CTA unchanged
// (embedUrl fails closed to null). No relay needed here: unlike a chrome-extension:// page, this site sends
// a valid Referer, so it frames the provider directly. CSP frame-src already allows all four providers.
const videoSrc = d.url ? embedUrl(d.url) : null;
---
<BaseLayout title={title} description={desc ?? `A link ${authorDisplay(d.author)} shared with the GBTI Network.`} ogImage={typeof d.image === 'string' && d.image ? d.image : undefined} ogType="article">
  <div class="wrap detail-page" data-gbti-reader-hash={`tab=share&read=${encodeURIComponent(slug)}`}>
    <nav class="share-crumb"><a href="/feeds/shares/" class="link">&larr; Shares feed</a></nav>
    <div class="detail-grid">
    <div class="detail-main">
    <article>
      <div class="feed-meta" style="margin-bottom:14px">
        {/* owner QA 2026-07-22: the SOURCE is the larger circle; the member avatar rides as the badge. */}
        <span class="share-src-stack">
          {srcDomain
            ? <a href={outUrl} target="_blank" rel="noopener nofollow" aria-label={`Visit ${srcDomain}`}><img class="sss-src" alt="" width="36" height="36" src={`https://www.google.com/s2/favicons?domain=${encodeURIComponent(srcDomain)}&sz=64`} onerror="this.remove()" /></a>
            : <a href={authorHref(d.author)}><Avatar item={{ name: authorDisplay(d.author), avatar }} class="av" size={36} /></a>}
          {srcDomain && <a class="sss-member" href={authorHref(d.author)} aria-label={authorDisplay(d.author)}><Avatar item={{ name: authorDisplay(d.author), avatar }} class="av" size={20} /></a>}
        </span>
        <span class="tmeta"><a class="who" href={authorHref(d.author)}>{authorDisplay(d.author)}</a><span class="dotsep"></span>{formatDate(d.createdAt)}</span>
        <span class="kind-tag kt-share">shared{srcDomain ? ` · ${srcDomain}` : ''}</span>
      </div>

      <h1 class="h1 share-title">{title}</h1>
      {quotedDesc && <p class="lead share-quote" style="margin-top:14px">{quotedDesc} <span class="sq-credit">- {srcDomain ?? 'the source'}</span></p>}

      {videoSrc
        ? <div class="share-player"><VideoEmbed video={d.url!} title={title} /></div>
        : typeof d.image === 'string' && d.image && (
            <a href={outUrl} target="_blank" rel="noopener nofollow" class="share-hero" aria-hidden="true" tabindex="-1"><img src={d.image} alt="" loading="lazy" decoding="async" /></a>
          )}

      {body && (
        <article class="card share-member-note" style="padding:24px;margin-top:26px">
          <div class="flex items-center g12">
            <a href={authorHref(d.author)} class="shrink-0"><Avatar item={{ name: authorDisplay(d.author), avatar }} size={44} class="rounded-full" /></a>
            <div>
              <p class="eyebrow" style="color:var(--green-700)">From the member</p>
              <a href={authorHref(d.author)} class="link" style="font-weight:700;display:inline-flex">{authorDisplay(d.author)}</a>
            </div>
          </div>
          <div class="cmt-rich" style="margin-top:14px;color:var(--fg)" set:html={body} />
        </article>
      )}

      <div class="share-actions">
        {d.url && <a href={outUrl} target="_blank" rel="noopener nofollow" class="btn btn-primary">{videoSrc ? 'Watch video on' : 'Read on'} {srcDomain ?? 'the source'} <svg class="ar" viewBox="0 0 24 24" width="18" height="18"><use href="#ico-arrow"/></svg></a>}
        <FavoriteButton targetType="share" targetSlug={slug} count={favoriteCount('share', slug)} />
        <CollectionButton targetType="share" targetSlug={slug} />
      </div>


      {d.tags?.length > 0 && (
        <div class="tags" style="margin-top:22px">
          {d.tags.map((t: string) => <a class="tag" href={`/feeds/?tag=${encodeURIComponent(String(t).toLowerCase())}`}>#{String(t).toLowerCase()}</a>)}
        </div>
      )}
    </article>

    {/* The member discussion: share comments are members-only + encrypted (SOW-044), so the thread
        renders locked placeholders for visitors with the become-a-member nudge, and upgrades in the
        extension for members. */}
    <Comments targetType="share" targetSlug={slug} author={d.author} wide={true} />
    </div>

    {/* The extension-style right sidebar (owner QA, 2026-07-21): the member card + the source card. */}
    <aside class="detail-side">
      <div class="card side-author-card">
        <a href={authorHref(d.author)} class="sac-head">
          <Avatar item={{ name: authorDisplay(d.author), avatar }} class="av" size={52} />
          <span class="sac-info">
            <span class="sac-name">{authorDisplay(d.author)}</span>
            {headline && <span class="sac-role">{headline}</span>}
          </span>
        </a>
        <SubscribeButton name={authorDisplay(d.author)} username={d.author} variant="ghost" />
      </div>
      {srcDomain && (
        <div class="card news-source-card">
          <img class="nsc-fav" alt="" width="40" height="40" src={`https://www.google.com/s2/favicons?domain=${encodeURIComponent(srcDomain)}&sz=64`} onerror="this.remove()" />
          <div class="nsc-info">
            <div class="nsc-name">{srcDomain}</div>
            <div class="nsc-desc">The source {authorDisplay(d.author)} shared this from.</div>
          </div>
          {d.url && <a href={outUrl} target="_blank" rel="noopener nofollow" class="btn btn-ghost nsc-follow">Visit</a>}
        </div>
      )}
    </aside>
    </div>
  </div>
</BaseLayout>

<style>
  /* Scoped on purpose: the inline player sits where .share-hero would, with the same top gap, but its
     radius + background come from VideoEmbed itself. Kept off src/styles/gbti-v3.css so this page owns
     the one rule it needs. */
  .share-player { margin-top: 26px; }
</style>
