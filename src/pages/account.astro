---
// sow-158 Part 3: the /account member hub. Signed-out visitors get the sign-in prompt; a signed-in member gets a
// grid of membership surfaces, a Share composer (members-only by default), and the tier-gated community Shares
// stream. The composer + feed are the SAME client-ui components the extension uses, wired to the cookie-session
// adapter (src/lib/workbench-client) -- no GitHub token in the page. noindex: a private, per-member surface.
import BaseLayout from '../layouts/BaseLayout.astro';
import FeedView from '../components/feeds/FeedView.astro';
import { loadFeedItems } from '../lib/feed-items';

// The membership button grid. Icons come from the site sprite (#ico-*). `#tab=` deep-links land in the WorkBench.
//
// sow-218 (2026-08-11): three tiles removed on owner direction. `Membership` duplicated the ghost button sitting
// directly above it in the same view, and `Community` pointed at /membership/ rather than at anything
// community-shaped, so both were noise rather than navigation. `Browse the co-op` went with them. `My Workspace`
// became `My Workbench` to match its destination, which has been called the WorkBench everywhere else since sow-158.
const GRID = [
  { icon: 'grid', label: 'My Workbench', href: '/workbench/' },
  { icon: 'pencil', label: 'New article', href: '/workbench/#tab=post' },
  { icon: 'box', label: 'New product', href: '/workbench/#tab=product' },
  { icon: 'terminal', label: 'New prompt', href: '/workbench/#tab=prompt' },
  { icon: 'merge', label: 'My pull requests', href: '/workbench/#tab=prs' },
  { icon: 'heart', label: 'Saved', href: '/workbench/#tab=saved' },
  { icon: 'users', label: 'Following', href: '/workbench/#tab=subs' },
  { icon: 'mega', label: 'News', href: '/news/' },
  { icon: 'search', label: 'Member directory', href: '/members/' },
  { icon: 'chart', label: 'Revenue model', href: '/revenue-model/' },
];

// sow-218: Latest Activity reuses the SHARED feed component (sow-131), the same one behind the homepage and every
// /feeds/ narrow, so the hub shows the same cards, tabs, filters and ladder pager rather than a second bespoke list.
// Loaded exactly as src/pages/feeds/index.astro loads it.
const { contentItems, shareItems, membersShareCount, avatarIndex } = await loadFeedItems();
---
<BaseLayout title="Account" description="Your GBTI Network account." noindex={true}>
  <section class="band">
    <div class="wrap acct-wrap">
      {/* Signed-OUT fallback (also the pre-hydration state; static SSG has no request-time cookie). */}
      <div class="sec-head center" data-account-signedout>
        <span class="itile"><svg viewBox="0 0 24 24"><use href="#ico-id"/></svg></span>
        <h1 class="h1 mt24">Your account</h1>
        <p class="lead">
          Sign in with GitHub to manage your GBTI Network membership, post to the co-op stream, and follow the
          community. Add the browser extension to edit and publish your content in place.
        </p>
        <a href="/login/?return_to=%2Faccount%2F" class="btn btn-primary btn-lg mt24">Sign in <svg class="ar" viewBox="0 0 24 24" width="18" height="18"><use href="#ico-arrow"/></svg></a>
      </div>

      {/* Signed-IN hub, hydrated client-side from the httpOnly-cookie session (member-signal.ts). */}
      <div data-account-signedin hidden>
        <div class="sec-head center">
          <img class="acct-av" data-account-av alt="" width="64" height="64" decoding="async" />
          <h1 class="h1 mt16">Welcome, <span data-account-name>@you</span></h1>
          <p class="lead">Membership: <strong data-account-status>&hellip;</strong></p>
          <div class="acct-actions mt16">
            <a href="/membership/" class="btn btn-ghost">Membership</a>
            <button type="button" class="btn btn-primary" data-account-signout>Sign out</button>
          </div>
        </div>

        {/* The membership button grid. */}
        <div class="grid" role="list">
          {GRID.map((g) => (
            <a class="tile" role="listitem" href={g.href}>
              <span class="tile-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><use href={`#ico-${g.icon}`}/></svg></span>
              <span class="tile-lb">{g.label}</span>
            </a>
          ))}
          <a class="tile" role="listitem" href="/members/" data-account-profile hidden>
            <span class="tile-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-github"/></svg></span>
            <span class="tile-lb">My profile</span>
          </a>
          <a class="tile tile-admin" role="listitem" href="/admin/" data-account-admin hidden>
            <span class="tile-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-lock"/></svg></span>
            <span class="tile-lb">Admin tools</span>
          </a>
        </div>

        {/* sow-218: ONE column now, composer above activity. The composer is CREATOR-ONLY and starts hidden, so the
            fail-closed direction is the rendered default: an unresolved tier shows nothing rather than briefly
            offering a control the server would refuse. render() reveals it only on paidTier === 'creator'. */}
        <div class="hub-cols">
          <div class="hub-card" data-share-card hidden>
            <h2 class="hub-h">Share with the community</h2>
            <p class="hub-sub">Post a note or a link to the members stream. Members-only is the default; switch to public to share it on the site feed.</p>
            <div data-share-mount>
              <p class="hub-load">Loading the composer&hellip;</p>
              <gbti-share-composer></gbti-share-composer>
            </div>
          </div>
          <div class="hub-card hub-card-feed">
            <h2 class="hub-h">Latest Activity</h2>
            <p class="hub-sub">Everything the network is shipping and sharing. Filter by kind, or narrow to member content.</p>
            <FeedView narrow="all" items={[...contentItems, ...shareItems]} avatarIndex={avatarIndex} membersShareCount={membersShareCount} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { onMemberSignal, currentIdentity, readMemberSignal, signOutWeb } from '../lib/member-signal';

    const out = document.querySelector('[data-account-signedout]');
    const inn = document.querySelector('[data-account-signedin]') as HTMLElement | null;
    const nameEl = document.querySelector('[data-account-name]');
    const av = document.querySelector('[data-account-av]') as HTMLImageElement | null;
    const statusEl = document.querySelector('[data-account-status]');
    const profileTile = document.querySelector('[data-account-profile]') as HTMLAnchorElement | null;
    const adminTile = document.querySelector('[data-account-admin]') as HTMLElement | null;
    const shareCard = document.querySelector('[data-share-card]') as HTMLElement | null; // sow-218: creator-only
    const LABELS: Record<string, string> = { paid: 'Paid member', trialing: 'Free trial', expired: 'Expired', cancelled: 'Cancelled', none: 'No active membership', banned: 'Suspended', unknown: 'Signed in' };
    const RANK: Record<string, number> = { member: 0, moderator: 1, admin: 2, superadmin: 3 };

    let mounted = false; // the client-ui composer + feed load once, on the first signed-in signal

    function render(s: any) {
      const signedIn = !!(s && s.login);
      if (out) (out as HTMLElement).hidden = signedIn;
      if (inn) inn.hidden = !signedIn;
      if (!signedIn) return;
      if (nameEl) nameEl.textContent = '@' + s.login;
      if (av) { av.src = 'https://github.com/' + encodeURIComponent(s.login) + '.png?size=128'; av.alt = '@' + s.login; }
      if (statusEl) statusEl.textContent = LABELS[s.membership] || LABELS.unknown;
      if (profileTile) { profileTile.href = '/members/' + encodeURIComponent(s.login) + '/'; profileTile.hidden = false; }
      if (adminTile) adminTile.hidden = (RANK[s.role] ?? 0) < RANK.moderator; // staff-only, role from the oracle
      // sow-218: publishing a Share is a Content Creator perk (sow-185), so the composer is tier-gated. Compared
      // to the exact string rather than a rank, and defaulting to hidden, so an absent, unknown or newly added
      // tier hides it: the same "absent means less privilege" rule membership/tiers.mjs applies server-side.
      // This is a presentational gate. The Worker share endpoint remains the real boundary (sow-218 Phase 2).
      const isCreator = s.paidTier === 'creator';
      if (shareCard) shareCard.hidden = !isCreator;
      mountHub(s, isCreator);
    }

    // sow-218: only the composer needs the client now. Latest Activity is the server-rendered FeedView, so the
    // shares-feed element is no longer imported here, and a non-creator loads no client-ui bundle at all.
    async function mountHub(s: any, isCreator: boolean) {
      if (mounted || !isCreator) return;
      mounted = true;
      const signupBase = document.documentElement.dataset.signupBase || '';
      const { createWorkbenchClient } = await import('../lib/workbench-client');
      const { setClient } = await import('../../client-ui/src/base.mjs');
      const adapter = createWorkbenchClient({ signupBase, login: String(s.login), githubId: s.githubId != null ? String(s.githubId) : null });
      setClient(adapter);
      document.querySelectorAll('.hub-load').forEach((el) => el.setAttribute('hidden', ''));
      // Defining the element upgrades the static tag; it renders on the setClient subscriber fan-out.
      await import('../../client-ui/src/elements/gbti-share-composer.mjs');
    }

    av?.addEventListener('error', () => { if (av) av.src = '/favicon-32x32.png'; });
    render(currentIdentity(readMemberSignal()));
    onMemberSignal(render); // BaseLayout invokes hydrateMemberSignal(); the cookie member arrives here
    document.querySelector('[data-account-signout]')?.addEventListener('click', async () => {
      document.dispatchEvent(new CustomEvent('gbti:request-signout')); // extension (no-op if absent)
      await signOutWeb(); // cookie session
      location.reload();
    });
  </script>

  <style>
    .acct-wrap { max-width: 1040px; }
    .acct-av { border-radius: 50%; border: 2px solid var(--line-2); margin: 0 auto; }
    .acct-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; margin-top: 32px; }
    .tile { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 20px 12px; border: 1.5px solid var(--line); border-radius: 14px; background: var(--panel); color: var(--fg); text-decoration: none; text-align: center; transition: border-color .12s, transform .12s; }
    .tile:hover { border-color: var(--brand); transform: translateY(-1px); }
    .tile-ic { display: inline-flex; }
    .tile-ic svg { width: 26px; height: 26px; color: var(--brand); }
    .tile-lb { font-size: 13.5px; font-weight: 600; line-height: 1.25; }
    .tile-admin .tile-ic svg { color: var(--fg-mute); }

    /* sow-218: ONE column. The composer stacks above Latest Activity rather than sitting beside it. */
    .hub-cols { display: grid; grid-template-columns: 1fr; gap: 20px; margin-top: 40px; align-items: start; }
    .hub-card { border: 1.5px solid var(--line); border-radius: 16px; background: var(--panel); padding: 20px; }
    .hub-card[hidden] { display: none; } /* an explicit display would otherwise beat the UA [hidden] rule */
    .hub-h { font-size: 18px; margin: 0 0 4px; }
    .hub-sub { color: var(--fg-mute); font-size: 13.5px; margin: 0 0 16px; }
    .hub-load { color: var(--fg-mute); font-size: 14px; }
    .hub-load[hidden] { display: none; }

    /* FeedView ships its own .wrap padding + max-width for a full-page context. Inside this card it is already
       inside .acct-wrap, so neutralize the doubled gutter rather than restyling the shared component. */
    .hub-card-feed :global(.feedwrap) { padding-left: 0; padding-right: 0; max-width: none; }
  </style>
</BaseLayout>
