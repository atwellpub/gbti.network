---
// SOW-136: the feed homepage, built from the "GBTI Homepage.html" Claude Design handoff. A magazine
// feed over real content: New & Popular (ranked by favorites + comments), The Feed (articles,
// products, prompts, and PUBLIC member shares, newest first, revealed by the shared ladder pager),
// and a sidebar (join card, the Shop Talk live card, members worth following, trending tags that
// drill into /feeds/?tag=). The item builders + the feed list are shared with the sow-131 /feeds/
// views (src/lib/feed-items.ts + src/components/feeds/FeedList.astro). The previous marketing
// homepage is archived unindexed at /home/v1/.
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import FavoriteButton from '../components/FavoriteButton.astro';
import FeedList from '../components/feeds/FeedList.astro';
import { authorDisplay, authorHref } from '../lib/authors';
import { loadFeedItems } from '../lib/feed-items';
import { sortByNewest, rankNewAndPopular, aggregateTags, relativeTime, feedCounts, heatCells } from '../lib/home-feed.mjs';
import { commitsByDate, commitCount } from '../lib/git-history';
import { TRIAL_DAYS_SITE, FIRST_TOUCH_PCT, SIGNUP_BASE } from '../lib/membership';

const { contentItems, shareItems, profiles, avatarIndex } = await loadFeedItems();

// New & Popular: member content only (no shares), favorites x3 + comments x2, newest breaks ties.
const np = rankNewAndPopular(contentItems, 6);
const npCols = [np.filter((_, i) => i % 2 === 0), np.filter((_, i) => i % 2 === 1)];

// The Feed: everything, newest first. All items render (SEO); the ladder pager reveals 10 at a time.
const feed = sortByNewest([...contentItems, ...shareItems]);

// Members worth following: directory opt-ins, ranked by their most recent published activity.
const latestByAuthor = new Map<string, number>();
for (const it of feed) if (it.date) latestByAuthor.set(it.author, Math.max(latestByAuthor.get(it.author) ?? 0, it.date));
const follow = profiles
  .filter((p) => p.data.directory)
  .sort((a, b) => (latestByAuthor.get(b.data.username) ?? 0) - (latestByAuthor.get(a.data.username) ?? 0))
  .slice(0, 5);
function roleLine(p: any): string {
  return p.data.headline || [...(p.data.roles ?? []), ...(p.data.skills ?? [])].slice(0, 2).join(' · ') || 'GBTI member';
}

// Trending tags drill into the feed tag view (sow-131): /feeds/?tag=<tag>.
const tags = aggregateTags([...contentItems, ...shareItems], 9);

// sow-192 (homepage v2): the tabbed feed. One blended feed (Everything) is server-rendered; the content
// tabs FILTER it in-page by kind, and every tab keeps its /feeds/<narrow>/ href for no-JS + SEO. Counts
// are the build-time totals (feedCounts); the News tab has no static count (runtime worker data) and its
// tab navigates to /feeds/news/ rather than filtering. Label "Prompts & Skills" per the mockup; the kind
// stays `prompt` until a Skill content type is decided (sow-192 Q4).
const counts = feedCounts(contentItems, shareItems);
const feedTabs: { key: string; label: string; href: string; count: number | null }[] = [
  { key: 'all', label: 'Everything', href: '/feeds/', count: counts.all },
  { key: 'news', label: 'News', href: '/feeds/news/', count: null },
  { key: 'articles', label: 'Articles', href: '/feeds/articles/', count: counts.articles },
  { key: 'products', label: 'Products', href: '/feeds/products/', count: counts.products },
  { key: 'prompts', label: 'Prompts & Skills', href: '/feeds/prompts/', count: counts.prompts },
  { key: 'shares', label: 'Shares', href: '/feeds/shares/', count: counts.shares },
];

// sow-192: a REAL git-commit activity heatmap (this replaced the earlier publish-date bucketing, which read
// as an activity graph but was not one). commitsByDate() reads the whole repo history at build and is
// fail-closed to empty on a shallow clone; heatCells buckets it into 7x36 level-0..4 cells scaled to the
// busiest cell. The counters are honest, non-windowed totals only (no reads/installs/"this week"):
// commits / articles / products / prompts / members. The deploy build checks out at fetch-depth: 0, so
// production has the full history (a shallow/git-less build simply renders an empty band).
const HEAT_CELLS = 7 * 36;
const commitStamps = commitsByDate().flatMap(([day, n]) => Array(n).fill(new Date(day).valueOf()));
const heat: number[] = heatCells(commitStamps, HEAT_CELLS);
const memberCount = profiles.length;
const actStats = [
  { n: commitCount(), l: 'commits' },
  { n: counts.articles, l: 'articles' },
  { n: counts.products, l: 'products' },
  { n: counts.prompts, l: 'prompts' },
  { n: memberCount, l: memberCount === 1 ? 'member' : 'members' },
];

// Build-time "now" for relative times (the site redeploys on every push, so drift stays small).
const NOW = Date.now();

// Shop Talk: the weekly open call. The calendar CTA is membership-aware (owner directive, 2026-07-21):
// a visitor goes to the join page; a signed-in member (the SOW-030 extension identity signal,
// presentation-only) gets the Google Calendar link that adds the recurring event to their own calendar.
// Provisioning note (SOW-136): confirm the schedule, and optionally replace calendarUrl with the real
// revolving event's public add link (calendar/event?action=TEMPLATE&tmeid=...) once shared.
const SHOPTALK = {
  name: 'Shop Talk call',
  when: 'Saturdays · 11:00 AM CST',
  desc: 'Our weekly open call: demos, feedback, and whatever you are stuck on. Everyone is welcome.',
  calendarUrl:
    'https://calendar.google.com/calendar/render?action=TEMPLATE' +
    '&text=' + encodeURIComponent('GBTI Shop Talk call') +
    '&details=' + encodeURIComponent('The GBTI Network weekly open call: demos, feedback, and whatever you are stuck on. https://gbti.network/') +
    '&dates=20260725T110000/20260725T130000&ctz=America/Chicago' +
    '&recur=' + encodeURIComponent('RRULE:FREQ=WEEKLY;BYDAY=SA'),
};

const kindLabel: Record<string, string> = { article: 'article', product: 'product', prompt: 'prompt' };
---
<BaseLayout title="Publish your work. Build with peers. Share the revenue." description={`A creator network powered by Git. Publish articles, products, and prompts, build with peers, and earn from the members your work brings in. Start a ${TRIAL_DAYS_SITE}-day limited-access trial, no card required.`}>

<div class="wrap feedwrap">

  <!-- ============ NEW & POPULAR ============ -->
  <section class="np" aria-label="New and popular member content">
    <div class="feed-lab"><span class="dot"></span><span class="t">New &amp; Popular</span><span class="rule"></span><span class="more">Member articles, products &amp; prompts</span></div>
    <div class="np-grid">
      {npCols.map((col) => (
        <div class="np-col">
          {col.map((it) => (
            <article class="np-item">
              {it.href ? (
                <a class="np-thumb" href={it.href} aria-hidden="true" tabindex="-1">{it.thumb && <img src={it.thumb} alt="" loading="lazy" decoding="async" />}</a>
              ) : (
                <span class="np-thumb">{it.thumb && <img src={it.thumb} alt="" loading="lazy" decoding="async" />}</span>
              )}
              <div class="np-body">
                <div class="tmeta"><a class="who" href={authorHref(it.author)}>{authorDisplay(it.author)}</a><span class="dotsep"></span>{relativeTime(it.date, NOW)}{it.read ? <><span class="dotsep"></span>{it.read} min</> : null}</div>
                <h3 class="np-title">{it.href ? <a href={it.href}>{it.title}</a> : it.title}</h3>
                <div class="rx-row">
                  <span class={`kind-tag kt-${it.kind}`}>{kindLabel[it.kind]}</span>
                  {it.stub && <span class="kind-tag kt-members">members</span>}
                  {!it.stub && <FavoriteButton targetType={it.targetType as 'post' | 'product' | 'prompt'} targetSlug={it.slug} count={it.favorites} size="sm" />}
                  <span class="rx rx-static"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-chat"/></svg> {it.comments}<span class="sr-only"> comments</span></span>
                </div>
              </div>
            </article>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- ============ FEED + SIDEBAR ============ -->
  <div class="feed-layout">
    <main class="feed-page home-feed" data-view="detailed" data-hometabs aria-label="The network feed" data-signup-base={SIGNUP_BASE}>
      <div class="feed-lab" id="feed"><span class="dot"></span><span class="t">The Feed</span><span class="rule"></span><a class="more" href="/feeds/">Everything, including member shares</a></div>

      <nav class="feed-tabs" aria-label="Feed views">
        {feedTabs.map((t) => (
          <a href={t.href} data-hometab={t.key} class:list={['feed-tab', t.key === 'all' && 'on']} aria-current={t.key === 'all' ? 'true' : undefined}>
            {t.label}{t.count !== null && <b class="tc">{t.count}</b>}
          </a>
        ))}
      </nav>

      <div class="feed-toolbar">
        <span class="feed-tb-sp"></span>
        <div class="view-toggle" role="group" aria-label="Density">
          <button type="button" class="vt-btn" data-feedview-density="card" aria-pressed="false" aria-label="Cards" data-tooltip="Cards" data-tooltip-pos="below"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><use href="#ico-grid"/></svg></button>
          <button type="button" class="vt-btn on" data-feedview-density="detailed" aria-pressed="true" aria-label="Detailed" data-tooltip="Detailed" data-tooltip-pos="below"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><use href="#ico-list"/></svg></button>
          <button type="button" class="vt-btn" data-feedview-density="compact" aria-pressed="false" aria-label="Compact" data-tooltip="Compact" data-tooltip-pos="below"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
        </div>
      </div>

      <FeedList items={feed} avatarIndex={avatarIndex} />
    </main>

    <aside class="side">
      <!-- join promo -->
      <div class="card side-card join-card" id="join">
        <div class="ttl"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-spark"/></svg> Join the co-op</div>
        <p class="side-sub" style="margin-top:8px">Publish your work, build with peers, and earn from what you make.</p>
        <ul class="join-list">
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-pencil"/></svg> Publish articles, products &amp; prompts</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-chat"/></svg> Private Discord &amp; weekly build calls</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-coin"/></svg> Earn up to {FIRST_TOUCH_PCT} from members your work brings in</li>
        </ul>
        <a href="/membership/" class="btn btn-primary" style="width:100%;justify-content:center">Start your free trial</a>
        <p class="note">{TRIAL_DAYS_SITE}-day limited-access trial · no card required</p>
      </div>

      <!-- live / events -->
      <div class="card side-card live-card">
        <div class="glow"></div>
        <div class="live-flag"><span class="pulse"></span> Live this Saturday</div>
        <div class="lc-ttl">{SHOPTALK.name}</div>
        <div class="lc-when">{SHOPTALK.when}</div>
        <p class="lc-desc">{SHOPTALK.desc}</p>
        <a href="/membership/" data-shoptalk-cta data-calendar-url={SHOPTALK.calendarUrl} class="btn btn-white">Add to calendar</a>
        <div class="evt">
          <div class="cal"><span class="m">Sat</span><span class="d" data-shoptalk-day></span></div>
          <div class="ei"><div class="n">{SHOPTALK.name}</div><div class="t2">Sat · 11:00 AM CST</div></div>
        </div>
      </div>

      <!-- members worth following -->
      <div class="card side-card">
        <div class="side-h">Members worth following</div>
        <div class="mtf">
          {follow.map((m) => (
            <a class="mtf-row" href={authorHref(m.data.username)}>
              <Avatar item={{ name: m.data.displayName, avatar: m.data.avatar }} class="lav" size={40} />
              <div class="mtf-info"><div class="mtf-name">{m.data.displayName}</div><div class="mtf-role">{roleLine(m)}</div></div>
            </a>
          ))}
        </div>
      </div>

      <!-- trending tags (drill into the feed tag view) -->
      {tags.length > 0 && (
        <div class="card side-card">
          <div class="side-h">Trending tags</div>
          <div class="tags">
            {tags.map((t) => <a class="tag" href={`/feeds/?tag=${encodeURIComponent(t.tag)}`}>#{t.tag} <b>{t.count}</b></a>)}
          </div>
        </div>
      )}
    </aside>
  </div>
</div>

<!-- ============ ACTIVITY (the v1 git grid, above the footer) ============ -->
<section class="band tint" id="activity">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">All network activity powered through Git</p>
      </div>
      <a href="https://github.com/gbti-network/gbti.network" class="link">View the public repo <svg class="ar" viewBox="0 0 24 24" width="18" height="18"><use href="#ico-arrow"/></svg></a>
    </div>
    <div class="card act-card">
      <p class="mono" style="font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--fg-mute);margin-bottom:16px">Commit activity</p>
      <div class="heat heat-wide" aria-hidden="true">{heat.map((lv) => <span class={lv ? `l${lv}` : undefined}></span>)}</div>
      <div class="heat-legend">
        <span>Less</span>
        <i style="background:var(--tint)"></i><i class="l1"></i><i class="l2"></i><i class="l3"></i><i class="l4"></i>
        <span>More</span>
      </div>
      <div class="act-stats">
        {actStats.map((s) => <div class="stat"><div class="n">{s.n}</div><div class="l">{s.l}</div></div>)}
      </div>
    </div>
  </div>
</section>

<!-- ============ JOIN THE NETWORK ============ -->
<!-- The nine-offer card grid lives in src/components/JoinOffers.astro (lifted off the homepage per
     owner QA, arrangement preserved for reuse); the homepage keeps the simple CTA band. -->
<section class="band" id="join-network">
  <div class="wrap">
    <div class="sec-head center" style="margin-bottom:0">
      <h2 class="h2">Join the GBTI Network</h2>
      <p class="lead">Publish your work, build with peers, and earn from what you make.</p>
      <div class="mt24"><a href="/membership/" class="btn btn-primary btn-lg">Start your free trial <svg class="ar" viewBox="0 0 24 24" width="18" height="18"><use href="#ico-arrow"/></svg></a></div>
      <p class="mono muted" style="font-size:13px;margin-top:14px">{TRIAL_DAYS_SITE}-day limited-access trial · no card required</p>
    </div>
  </div>
</section>

<script is:inline>
  // The Shop Talk live card: stamp the next Saturday's date chip, and make the calendar CTA
  // membership-aware (owner directive): a visitor goes to the join page; a signed-in member (the
  // SOW-030 extension identity signal, presentation-only, untrusted) gets the Google Calendar add
  // link. The feed ladder pager lives in the shared FeedList component.
  (function () {
    var d = new Date();
    d.setDate(d.getDate() + ((6 - d.getDay() + 7) % 7));
    var chip = document.querySelector('[data-shoptalk-day]');
    if (chip) chip.textContent = String(d.getDate());

    var cta = document.querySelector('[data-shoptalk-cta]');
    if (cta) {
      var calUrl = cta.getAttribute('data-calendar-url');
      function applyCta(signedIn) {
        if (signedIn && calUrl) {
          cta.setAttribute('href', calUrl);
          cta.setAttribute('target', '_blank');
          cta.setAttribute('rel', 'noopener');
        } else {
          cta.setAttribute('href', '/membership/');
          cta.removeAttribute('target');
          cta.removeAttribute('rel');
        }
      }
      function signalPresent() {
        try {
          var raw = document.documentElement.dataset.gbtiMember;
          return !!raw && JSON.parse(raw).authenticated === true;
        } catch (e) { return false; }
      }
      applyCta(signalPresent());
      document.addEventListener('gbti:identity', function (e) {
        applyCta(!!(e.detail && e.detail.authenticated === true));
      });
    }
  })();
</script>
</BaseLayout>

<script>
  // sow-192 (homepage v2): the tabbed feed. Everything shows the full blended feed (member content plus
  // public shares, seeded inline as before); the Articles / Products / Prompts / Shares tabs FILTER the
  // already-rendered rows in-page by data-kind, reusing the /feeds/ flatten-ladder pattern. The News tab
  // is a real link to /feeds/news/ (news is runtime worker data, not part of the static feed), so it
  // navigates rather than filtering; every tab keeps its /feeds/<narrow>/ href for no-JS and SEO. The
  // 3-state density toggle shares the 'gbti-feed-view' key with /feeds/ so the choice stays consistent.
  (() => {
    const view = document.querySelector<HTMLElement>('[data-hometabs]');
    if (!view) return;
    const list = view.querySelector<HTMLElement>('[data-feedlist]');
    const tabs = Array.from(view.querySelectorAll<HTMLElement>('[data-hometab]'));
    // The tab key is a plural narrow (articles/products/prompts/shares); a feed row's data-kind is the
    // singular item kind (article/product/prompt/share). Map the active narrow to the kind it selects.
    const NARROW_KIND: Record<string, string> = { articles: 'article', products: 'product', prompts: 'prompt', shares: 'share' };
    let active = 'all';

    function applyFilter() {
      const filtered = active !== 'all';
      const wantKind = NARROW_KIND[active] || '';
      view!.classList.toggle('feed-flat', filtered);
      // Flatten the ladder while a kind filter is active: lift the chunks' hidden attribute (Tailwind's
      // layered [hidden]{display:none!important} outranks author CSS, so this must be done in JS), and
      // restore it on return to Everything.
      list?.querySelectorAll<HTMLElement>('.feed-chunk').forEach((c) => {
        if (filtered) {
          if (c.hidden) { c.setAttribute('data-rehide', '1'); c.hidden = false; }
        } else if (c.hasAttribute('data-rehide')) {
          c.hidden = true;
          c.removeAttribute('data-rehide');
        }
      });
      const rows = list ? Array.from(list.querySelectorAll<HTMLElement>('[data-fi]')) : [];
      rows.forEach((r) => { r.hidden = filtered && r.getAttribute('data-kind') !== wantKind; });
    }

    function setActive(key: string) {
      active = key;
      tabs.forEach((t) => {
        const on = t.getAttribute('data-hometab') === key;
        t.classList.toggle('on', on);
        if (on) t.setAttribute('aria-current', 'true'); else t.removeAttribute('aria-current');
      });
      applyFilter();
    }

    tabs.forEach((t) => {
      t.addEventListener('click', (e) => {
        const key = t.getAttribute('data-hometab') || 'all';
        if (key === 'news') return; // the News tab navigates to /feeds/news/ (runtime news lives there)
        e.preventDefault();
        setActive(key);
      });
    });

    // Late-arriving news rows (peppered in after the async fetch) must respect the active tab, so a user
    // who switched to a content tab before news loaded does not suddenly see news rows appear.
    document.addEventListener('gbti:feed-updated', applyFilter);

    // Density: card / detailed / compact, sharing the '/feeds/' persisted key. Default is detailed (the
    // mockup's "list"); a stored choice overrides it.
    const KEY = 'gbti-feed-view';
    const dBtns = Array.from(view.querySelectorAll<HTMLButtonElement>('[data-feedview-density]'));
    function setDensity(v: string) {
      view!.setAttribute('data-view', v);
      dBtns.forEach((x) => { const on = x.getAttribute('data-feedview-density') === v; x.classList.toggle('on', on); x.setAttribute('aria-pressed', String(on)); });
      try { localStorage.setItem(KEY, v); } catch { /* private mode */ }
    }
    dBtns.forEach((b) => b.addEventListener('click', () => setDensity(b.getAttribute('data-feedview-density') || 'detailed')));
    try {
      const stored = localStorage.getItem(KEY);
      if (stored === 'compact' || stored === 'detailed' || stored === 'card') setDensity(stored);
    } catch { /* private mode */ }
  })();
</script>

<script>
  // sow-141 QA (2026-07-24): pepper the public worker news into the homepage feed, client-side. The
  // static build carries only member content (SEO); news is runtime data from the anonymous
  // signup-Worker endpoint, spliced in on a 2-members : 1-news rhythm so news never exceeds one third
  // of the blended feed. Rows mirror the /feeds/news renderer (same feed-item vocabulary, internal
  // /news/item/ deep links). A failed fetch or an empty feed leaves the page exactly as built.
  import { newsInsertionPlan } from '../lib/home-feed.mjs';
  (() => {
    const main = document.querySelector('main[aria-label="The network feed"]');
    const base = main?.getAttribute('data-signup-base') || '';
    const list = main?.querySelector('[data-feedlist]');
    if (!base || !list) return;
    const relTime = (epochS: number) => {
      const s = Math.max(0, Math.floor(Date.now() / 1000 - epochS));
      if (s < 60) return 'just now';
      const m = Math.floor(s / 60); if (m < 60) return m + 'm ago';
      const h = Math.floor(m / 60); if (h < 24) return h + 'h ago';
      const d = Math.floor(h / 24); if (d < 30) return d + 'd ago';
      if (d < 365) return Math.max(1, Math.round(d / 30)) + 'mo ago';
      return Math.max(1, Math.round(d / 365)) + 'y ago';
    };
    const el = (t: string, cls?: string, text?: string) => {
      const n = document.createElement(t);
      if (cls) n.className = cls;
      if (text !== undefined) n.textContent = text;
      return n;
    };
    const newsRow = (it: any) => {
      const art = el('article', 'feed-item news-row' + (it.image ? '' : ' nocover'));
      art.setAttribute('data-fi', '');
      art.setAttribute('data-kind', 'news'); // sow-192: so a content tab filter hides peppered news rows
      const main2 = el('div', 'feed-main');
      const meta = el('div', 'feed-meta');
      meta.append(
        el('span', 'kind-tag kt-news', 'news' + (it.source ? ' · ' + it.source : '')),
        el('span', 'tmeta', typeof it.publishedAt === 'number' ? relTime(it.publishedAt) : ''),
      );
      const detailHref = '/news/item/?g=' + encodeURIComponent(String(it.guid || '')) + (it.source ? '&s=' + encodeURIComponent(String(it.source)) : '');
      const h2 = el('h2', 'feed-title');
      const a = el('a', undefined, String(it.title || 'Untitled'));
      a.setAttribute('href', detailHref);
      h2.append(a);
      main2.append(meta, h2);
      if (it.summary) {
        const sum = String(it.summary).trim();
        main2.append(el('p', 'feed-ex', /[.!?]["')\]]?$/.test(sum) ? sum : sum + '...'));
      }
      const foot = el('div', 'feed-foot');
      foot.append(el('span', 'fsp'));
      main2.append(foot);
      art.append(main2);
      const cover = el('a', 'feed-cover' + (it.image ? '' : ' feed-cover-fb'));
      cover.setAttribute('href', detailHref);
      cover.setAttribute('aria-hidden', 'true');
      cover.setAttribute('tabindex', '-1');
      const img = document.createElement('img');
      const imgUrl = it.image ? String(it.image).replace(/&#0*38;/g, '&').replace(/&amp;/g, '&') : '';
      img.src = imgUrl || '/brand/feature/feature-category.png';
      img.alt = '';
      img.loading = 'lazy';
      img.decoding = 'async';
      img.addEventListener('error', () => {
        img.src = '/brand/feature/feature-category.png';
        cover.classList.add('feed-cover-fb');
      }, { once: true });
      cover.append(img);
      art.append(cover);
      return art;
    };
    fetch(base + '/news/feed?limit=60')
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error('bad status'))))
      .then((data) => {
        const items = Array.isArray(data?.items) ? data.items : [];
        if (!items.length) return;
        const rows = Array.from(list.querySelectorAll('.feed-chunk [data-fi]'));
        const plan = newsInsertionPlan(rows.length, items.length);
        plan.forEach((pos, i) => rows[pos]?.after(newsRow(items[i])));
        // sow-192: let the tabbed-feed filter re-apply so late news rows respect the active content tab.
        document.dispatchEvent(new Event('gbti:feed-updated'));
      })
      .catch(() => { /* news is optional garnish; the built feed stands alone */ });
  })();
</script>
