---
// SOW-136: the feed homepage, built from the "GBTI Homepage.html" Claude Design handoff. A magazine
// feed over real content: New & Popular (ranked by favorites + comments), The Feed (articles,
// products, prompts, and PUBLIC member shares, newest first, revealed by the shared ladder pager),
// and a sidebar (join card, the Shop Talk live card, members worth following, trending tags that
// drill into /feeds/?tag=). The item builders + the feed list are shared with the sow-131 /feeds/
// views (src/lib/feed-items.ts + src/components/feeds/FeedList.astro). The previous marketing
// homepage is archived unindexed at /home/v1/.
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import FavoriteButton from '../components/FavoriteButton.astro';
import FeedList from '../components/feeds/FeedList.astro';
import ArticleTeaser from '../components/blog/ArticleTeaser.astro';
import ProductCard from '../components/products/ProductCard.astro';
import HomePromptCard from '../components/home/HomePromptCard.astro';
import PricingAccordion from '../components/home/PricingAccordion.astro';
import ExtensionBanner from '../components/home/ExtensionBanner.astro';
import PersonalizeModal from '../components/home/PersonalizeModal.astro';
import HomeShareModal from '../components/home/HomeShareModal.astro';
import { authorItem } from '../lib/avatars';
import { contentIcon } from '../lib/content-icons';
import { topLevelCategories } from '../lib/taxonomy';
import { getCollection } from 'astro:content';
import { isListed, byNewest } from '../lib/content';
import { authorDisplay, authorHref } from '../lib/authors';
import { loadFeedItems } from '../lib/feed-items';
import { sortByNewest, rankNewAndPopular, aggregateTags, feedCounts, commitsHeatGrid } from '../lib/home-feed.mjs';
import { commitsByDate, commitCount } from '../lib/git-history';
import { FIRST_TOUCH_PCT, SIGNUP_BASE } from '../lib/membership';

const { contentItems, shareItems, profiles, avatarIndex } = await loadFeedItems();

// sow-192: Popular moved into the right rail (it was a standalone New & Popular grid at the top). Ranked by
// favorites + comments, degrading to recency pre-launch. Member content only (no shares).
const popular = rankNewAndPopular(contentItems, 5);

// The Feed: everything, newest first. All items render (SEO); the ladder pager reveals 10 at a time.
const feed = sortByNewest([...contentItems, ...shareItems]);

// Members worth following: directory opt-ins, ranked by their most recent published activity.
const latestByAuthor = new Map<string, number>();
for (const it of feed) if (it.date) latestByAuthor.set(it.author, Math.max(latestByAuthor.get(it.author) ?? 0, it.date));
const follow = profiles
  .filter((p) => p.data.directory)
  .sort((a, b) => (latestByAuthor.get(b.data.username) ?? 0) - (latestByAuthor.get(a.data.username) ?? 0))
  .slice(0, 5);
function roleLine(p: any): string {
  return p.data.headline || [...(p.data.roles ?? []), ...(p.data.skills ?? [])].slice(0, 2).join(' · ') || 'GBTI member';
}

// Trending tags drill into the feed tag view (sow-131): /feeds/?tag=<tag>.
const tags = aggregateTags([...contentItems, ...shareItems], 9);

// sow-192 (homepage v2): the tabbed feed. One blended feed (Everything) is server-rendered; the content
// tabs FILTER it in-page by kind, and every tab keeps its /feeds/<narrow>/ href for no-JS + SEO. Counts
// are the build-time totals (feedCounts); the News tab has no static count (runtime worker data) and its
// tab navigates to /feeds/news/ rather than filtering. Label "Prompts & Skills" per the mockup; the kind
// stays `prompt` until a Skill content type is decided (sow-192 Q4).
const counts = feedCounts(contentItems, shareItems);
const feedTabs: { key: string; label: string; href: string; count: number | null }[] = [
  { key: 'all', label: 'Everything', href: '/feeds/', count: counts.all },
  { key: 'news', label: 'News', href: '/feeds/news/', count: null },
  { key: 'articles', label: 'Articles', href: '/feeds/articles/', count: counts.articles },
  { key: 'products', label: 'Products', href: '/feeds/products/', count: counts.products },
  { key: 'prompts', label: 'Prompts & Skills', href: '/feeds/prompts/', count: counts.prompts },
  { key: 'shares', label: 'Shares', href: '/feeds/shares/', count: counts.shares },
];

// sow-192 Phase B: the per-type section blocks (Everything tab only). Fed from the real content collections
// through the SAME cards the directory pages use (ArticleTeaser / ProductCard / PromptCard), isListed +
// newest-first. Sizes: Articles 6, Products 4, Prompts & Skills 3. "Runs on" logos + product license are
// deferred (sow-192 Q5/Q6); the cards render the fields that exist today.
const listedPosts = (await getCollection('post')).filter(isListed).sort(byNewest);
const listedProducts = (await getCollection('product')).filter(isListed).sort(byNewest);
const listedPrompts = (await getCollection('prompt')).filter(isListed).sort(byNewest);
const homeArticles = listedPosts.slice(0, 6);
const homeProducts = listedProducts.slice(0, 4);
const homePrompts = listedPrompts.slice(0, 3);
// The overlay prompt cards need the comment collection (for the "from the author" note) + profiles (avatars).
const homeComments = await getCollection('comment');
const homeProfiles = await getCollection('profile');

// sow-192 Phase D: the Personalize modal's candidate lists, emitted as a build-time JSON so the modal never
// guesses an endpoint shape. Members = directory opt-ins; categories = the taxonomy top levels present in the
// content; tags = the same trending set the sidebar uses.
const personalizeData = {
  members: homeProfiles
    .filter((p) => p.data.directory)
    .map((p) => ({ username: p.data.username, name: p.data.displayName, avatar: p.data.avatar ?? null })),
  categories: topLevelCategories([...listedPosts, ...listedProducts, ...listedPrompts].map((e) => e.data.categories)),
  tags,
};

// sow-206: a genuine, LABELED GitHub-style commit contribution graph (owner elected this over an earlier
// sow-192 grid that borrowed the contribution-graph look while plotting a transposed, drifting axis, and over
// a monthly bar chart). commitsByDate() reads the whole repo history at build (fail-closed to empty on a
// shallow clone); commitsHeatGrid maps it to real day cells, weeks as columns, from the first commit through
// this week (capped at a rolling year), with per-cell counts so accuracy is verifiable. The counters below stay
// honest, non-windowed totals: commits / articles / products / prompts / members. The deploy build checks out
// at fetch-depth: 0, so production has the full history (a shallow/git-less build renders an empty band).
const heatGrid = commitsHeatGrid(commitsByDate(), 53, Date.now());
const memberCount = profiles.length;
const actStats = [
  { n: commitCount(), l: 'commits' },
  { n: counts.articles, l: 'articles' },
  { n: counts.products, l: 'products' },
  { n: counts.prompts, l: 'prompts' },
  { n: memberCount, l: memberCount === 1 ? 'member' : 'members' },
];

// Shop Talk: the weekly open call. The calendar CTA is membership-aware (owner directive, 2026-07-21):
// a visitor goes to the join page; a signed-in member (the SOW-030 extension identity signal,
// presentation-only) gets the Google Calendar link that adds the recurring event to their own calendar.
// Provisioning note (SOW-136): confirm the schedule, and optionally replace calendarUrl with the real
// revolving event's public add link (calendar/event?action=TEMPLATE&tmeid=...) once shared.
const SHOPTALK = {
  name: 'Shop Talk call',
  when: 'Saturdays · 11:00 AM CST',
  desc: 'Our weekly open call: demos, feedback, and whatever you are stuck on. Everyone is welcome.',
  calendarUrl:
    'https://calendar.google.com/calendar/render?action=TEMPLATE' +
    '&text=' + encodeURIComponent('GBTI Shop Talk call') +
    '&details=' + encodeURIComponent('The GBTI Network weekly open call: demos, feedback, and whatever you are stuck on. https://gbti.network/') +
    '&dates=20260725T110000/20260725T130000&ctz=America/Chicago' +
    '&recur=' + encodeURIComponent('RRULE:FREQ=WEEKLY;BYDAY=SA'),
};

---
<BaseLayout title="Building Together. Linking Lives." description="A community for developers and creators, building the open internet together. Publish your articles, products, and prompts in the open, build alongside peers, and join the conversation in Discord. Free to read; become a member to comment and publish.">

<div class="wrap feedwrap">

  <!-- sow-192 Phase F: the pricing accordion (signed-out). Bound to src/lib/tiers.ts (TIER_DISPLAY); hidden
       for a signed-in member via the shared [data-home-joincard] hook. -->
  <PricingAccordion />

  <!-- "GBTI Homepage" design (owner-elected 2026-08-10): the logged-out Chrome-extension promo banner, between
       the pricing accordion and the feed. Carries [data-home-joincard], so the mount script hides it for a
       signed-in member. -->
  <ExtensionBanner />

  <!-- sow-192 Phase D: the Personalize modal + its build-time candidate lists (members/categories/tags). The
       modal itself is a fixed <dialog>, inert until the signed-in Personalize button opens it. -->
  <script type="application/json" id="gbti-personalize-data" set:html={JSON.stringify(personalizeData)}></script>
  <PersonalizeModal />

  <!-- sow-192 (Image #11/#12): the COLLAPSED creator composer bar. It opens the four-step Share wizard in a
       modal (HomeShareModal) instead of rendering the wizard inline. Paid-gated (data-home-creator) + hidden
       for signed-out / no-JS; revealed on the sow-158 member signal, which also lazy-mounts the client-ui
       composer into the modal (see the script below). -->
  <div class="home-share-bar" data-home-creator hidden>
    <button type="button" class="hsb-open" data-share-open>
      <img class="hsb-av" alt="" width="34" height="34" decoding="async" />
      <span class="hsb-prompt"><i class="hsb-caret" aria-hidden="true"></i>Share something with the network&hellip;</span>
      <span class="hsb-act hsb-share">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a3 3 0 1 0-2.82-4H15a3 3 0 0 0 .12.83l-6.1 3.55a3 3 0 1 0 0 4.24l6.1 3.55A3 3 0 1 0 18 16a3 3 0 0 0-1.77.58l-6.1-3.55a3 3 0 0 0 0-1.66l6.1-3.55A3 3 0 0 0 18 8Z" fill="currentColor"/></svg>Share
      </span>
    </button>
    <a class="hsb-act hsb-wb" href="/workbench/">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1Zm5-3h6a1 1 0 0 1 1 1v2H8V5a1 1 0 0 1 1-1Z" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>Workbench
    </a>
  </div>
  <HomeShareModal />

  <!-- ============ FEED + SIDEBAR ============ -->
  <div class="feed-layout">
    <main class="feed-page home-feed" data-view="detailed" data-hometabs aria-label="The network feed" data-signup-base={SIGNUP_BASE}>
      <div class="feed-lab" id="feed"><span class="dot"></span><span class="t">The Feed</span><span class="rule"></span><a class="more" href="/feeds/">Everything, including member shares</a></div>

      <nav class="feed-tabs" aria-label="Feed views">
        {feedTabs.map((t) => (
          <a href={t.href} data-hometab={t.key} class:list={['feed-tab', t.key === 'all' && 'on']} aria-current={t.key === 'all' ? 'true' : undefined}>
            {t.label}{t.count !== null && <b class="tc">{t.count}</b>}
          </a>
        ))}
        {/* sow-192: the feed ordering caption. SSR default "Newest first" (the honest default + the mockup's
            logged-out state); the personalize-apply script upgrades it to "Curated by..." only when the member
            has actually personalized the Everything tab (see the apply() hook below). */}
        <span class="feed-note" data-feed-note>Newest first</span>
      </nav>

      <div class="feed-toolbar">
        <button type="button" class="pz-open-btn" data-home-signedin data-personalize-open hidden><span class="pz-dot-blue"></span>Personalize</button>
        <span class="feed-tb-sp"></span>
        <div class="view-toggle" role="group" aria-label="Density">
          <button type="button" class="vt-btn" data-feedview-density="card" aria-pressed="false" aria-label="Cards" data-tooltip="Cards" data-tooltip-pos="below"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><use href="#ico-grid"/></svg></button>
          <button type="button" class="vt-btn on" data-feedview-density="detailed" aria-pressed="true" aria-label="Detailed" data-tooltip="Detailed" data-tooltip-pos="below"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><use href="#ico-list"/></svg></button>
          <button type="button" class="vt-btn" data-feedview-density="compact" aria-pressed="false" aria-label="Compact" data-tooltip="Compact" data-tooltip-pos="below"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
        </div>
      </div>

      <FeedList items={feed} avatarIndex={avatarIndex} />
    </main>

    <aside class="side">
      <!-- sow-192 Phase C: the signed-in "Your workbench" rail card (quick-create deep links into the
           WorkBench). Hidden for signed-out; revealed on the member signal. Live counts are a follow-up. -->
      <div class="card side-card" data-home-signedin hidden>
        <div class="side-h">Your workbench</div>
        <p class="side-sub" style="margin-top:6px">Publish and manage your work.</p>
        <div class="wb-links">
          <a href="/workbench/#tab=post"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-pencil"/></svg>New article</a>
          <a href="/workbench/#tab=product"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-box"/></svg>New product</a>
          <a href="/workbench/#tab=prompt"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-terminal"/></svg>New prompt</a>
          <a href="/workbench/#tab=prs"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-merge"/></svg>My pull requests</a>
          <a href="/workbench/#tab=saved"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-heart"/></svg>Saved</a>
          <a href="/workbench/" class="wb-open">Open WorkBench <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-arrow"/></svg></a>
        </div>
      </div>

      <!-- join promo (signed-out; hidden for a signed-in member, who sees Your workbench instead) -->
      <div class="card side-card join-card" id="join" data-home-joincard>
        <div class="ttl"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-spark"/></svg> Join the co-op</div>
        <p class="side-sub" style="margin-top:8px">Publish your work, build with peers, and earn from what you make.</p>
        <ul class="join-list">
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-pencil"/></svg> Publish articles, products &amp; prompts</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-chat"/></svg> Private Discord &amp; weekly build calls</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-coin"/></svg> Earn up to {FIRST_TOUCH_PCT} from members your work brings in</li>
        </ul>
        <a href="/login/" class="btn btn-primary" style="width:100%;justify-content:center">Create a free account</a>
        <p class="note">Free to read · no card required</p>
      </div>

      <!-- popular (sow-192: moved from the top New & Popular grid into the rail) -->
      {popular.length > 0 && (
        <div class="card side-card">
          <div class="side-h" style="display:flex;align-items:center;gap:7px"><span class="pop-dot"></span>Popular</div>
          <div class="pop-list">
            {popular.map((it) => (
              <a class="pop-row" href={it.href}>
                {it.thumb && <img class="pop-thumb" src={it.thumb} alt="" loading="lazy" decoding="async" />}
                <div class="pop-info">
                  <div class="pop-title">{it.title}</div>
                  <div class="pop-meta"><span class={`kind-tag kt-${it.kind}`}><svg class="kt-ico" viewBox="0 0 24 24" aria-hidden="true"><use href={`#${contentIcon(it.kind)}`}/></svg>{it.kind}</span><span class="pop-by"><Avatar item={authorItem(it.author, avatarIndex)} size={18} class="pop-av" />{authorDisplay(it.author)}</span></div>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- live / events -->
      <div class="card side-card live-card">
        <div class="glow"></div>
        <div class="live-flag"><span class="pulse"></span> Live this Saturday</div>
        <div class="lc-ttl">{SHOPTALK.name}</div>
        <div class="lc-when">{SHOPTALK.when}</div>
        <p class="lc-desc">{SHOPTALK.desc}</p>
        <a href="/membership/" data-shoptalk-cta data-calendar-url={SHOPTALK.calendarUrl} class="btn btn-white">Add to calendar</a>
        <div class="evt">
          <div class="cal"><span class="m">Sat</span><span class="d" data-shoptalk-day></span></div>
          <div class="ei"><div class="n">{SHOPTALK.name}</div><div class="t2">Sat · 11:00 AM CST</div></div>
        </div>
      </div>

      <!-- members worth following -->
      <div class="card side-card">
        <div class="side-h">Members worth following</div>
        <div class="mtf">
          {follow.map((m) => (
            <a class="mtf-row" href={authorHref(m.data.username)}>
              <Avatar item={{ name: m.data.displayName, avatar: m.data.avatar }} class="lav" size={40} />
              <div class="mtf-info"><div class="mtf-name">{m.data.displayName}</div><div class="mtf-role">{roleLine(m)}</div></div>
            </a>
          ))}
        </div>
      </div>

      <!-- trending tags (drill into the feed tag view) -->
      {tags.length > 0 && (
        <div class="card side-card">
          <div class="side-h">Trending tags</div>
          <div class="tags">
            {tags.map((t) => <a class="tag" href={`/feeds/?tag=${encodeURIComponent(t.tag)}`}>#{t.tag} <b>{t.count}</b></a>)}
          </div>
        </div>
      )}
    </aside>
  </div>
</div>

<!-- ============ SECTION BLOCKS (sow-192 Phase B; shown on the Everything tab, hidden under a content tab) ============ -->
<div data-home-sections>

  {homeArticles.length > 0 && (
  <section class="band home-sec" aria-label="Articles">
    <div class="wrap">
      <div class="sec-head">
        <div><h2 class="h2">Articles</h2><p class="home-sec-sub">{counts.articles} published</p></div>
        <a href="/articles/" class="link">All articles <svg class="ar" viewBox="0 0 24 24" width="18" height="18"><use href="#ico-arrow"/></svg></a>
      </div>
      <div class="works-grid">
        {homeArticles.map((p) => <ArticleTeaser post={p} />)}
      </div>
    </div>
  </section>
  )}

  {homePrompts.length > 0 && (
  <section class="band tint home-sec" aria-label="Prompts and Skills">
    <div class="wrap">
      <div class="sec-head">
        <div><h2 class="h2">Prompts &amp; Skills</h2><p class="home-sec-sub">{counts.prompts} published · one library, three kinds</p></div>
        <a href="/prompts/" class="link">All prompts &amp; skills <svg class="ar" viewBox="0 0 24 24" width="18" height="18"><use href="#ico-arrow"/></svg></a>
      </div>
      <div class="hp-grid">
        {homePrompts.map((p) => <HomePromptCard prompt={p} comments={homeComments} profiles={homeProfiles} />)}
      </div>
    </div>
  </section>
  )}

  {homeProducts.length > 0 && (
  <section class="band home-sec" aria-label="Products">
    <div class="wrap">
      <div class="sec-head">
        <div><h2 class="h2">Products</h2><p class="home-sec-sub">{counts.products} released · built by members</p></div>
        <a href="/products/" class="link">All products <svg class="ar" viewBox="0 0 24 24" width="18" height="18"><use href="#ico-arrow"/></svg></a>
      </div>
      <div class="works-grid">
        {homeProducts.map((p) => <ProductCard product={p} home />)}
      </div>
    </div>
  </section>
  )}

  <!-- Latest news: runtime worker fetch, filled by the news script below (hidden if the feed is empty). -->
  <section class="band tint home-sec" aria-label="Latest news" data-latest-news>
    <div class="wrap">
      <div class="sec-head">
        <div><h2 class="h2">Latest news</h2><p class="home-sec-sub">Curated developer news · not GBTI work</p></div>
        <a href="/feeds/news/" class="link">All news <svg class="ar" viewBox="0 0 24 24" width="18" height="18"><use href="#ico-arrow"/></svg></a>
      </div>
      <div class="feed-list" data-latest-news-list>
        <p class="feed-empty" data-latest-news-empty style="margin-top:20px">Loading the news stream&hellip;</p>
      </div>
    </div>
  </section>

</div>

<!-- ============ ACTIVITY (the git commit grid, above the footer) ============ -->
<section class="band tint" id="activity">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">All network activity powered through Git</p>
      </div>
      <a href="https://github.com/gbti-network/gbti.network" class="link">View the public repo <svg class="ar" viewBox="0 0 24 24" width="18" height="18"><use href="#ico-arrow"/></svg></a>
    </div>
    <div class="card act-card">
      <p class="mono" style="font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--fg-mute);margin-bottom:16px">Commit activity, past year</p>
      <div class="cgraph-wrap">
        <div class="cgraph">
          <div class="cg-months" style={`grid-template-columns:repeat(${heatGrid.weeks.length},minmax(11px,1fr))`} aria-hidden="true">
            {heatGrid.monthLabels.map((ml) => <span style={`grid-column:${ml.col + 1}`}>{ml.label}</span>)}
          </div>
          <div class="cg-wd" aria-hidden="true"><span style="grid-row:2">Mon</span><span style="grid-row:4">Wed</span><span style="grid-row:6">Fri</span></div>
          <div class="cg-cells" role="img" aria-label={`${heatGrid.total} commit${heatGrid.total === 1 ? '' : 's'} across the repository in the last year`} style={`grid-template-columns:repeat(${heatGrid.weeks.length},minmax(11px,1fr));aspect-ratio:${heatGrid.weeks.length}/7`}>
            {heatGrid.weeks.map((week) => week.map((day) => (
              day
                ? <span class={day.level ? `l${day.level}` : undefined} title={day.title}></span>
                : <span class="cg-future" aria-hidden="true"></span>
            )))}
          </div>
        </div>
      </div>
      <div class="cg-legend"><span>Less</span><i class="l0"></i><i class="l1"></i><i class="l2"></i><i class="l3"></i><i class="l4"></i><span>More</span></div>
      <div class="act-stats">
        {actStats.map((s) => <div class="stat"><div class="n">{s.n}</div><div class="l">{s.l}</div></div>)}
      </div>
    </div>
  </div>
</section>

<!-- ============ JOIN THE NETWORK ============ -->
<!-- The nine-offer card grid lives in src/components/JoinOffers.astro (lifted off the homepage per
     owner QA, arrangement preserved for reuse); the homepage keeps the simple CTA band. -->
<section class="band" id="join-network" data-home-joincard>
  <div class="wrap">
    <div class="sec-head center" style="margin-bottom:0">
      <h2 class="h2">Join the GBTI Network</h2>
      <p class="lead">Publish your work, build with peers, and earn from what you make.</p>
      <div class="mt24"><a href="/login/" class="btn btn-primary btn-lg">Create a free account <svg class="ar" viewBox="0 0 24 24" width="18" height="18"><use href="#ico-arrow"/></svg></a></div>
      <p class="mono muted" style="font-size:13px;margin-top:14px">Free to read · membership adds comments, Discord, and publishing</p>
    </div>
  </div>
</section>

<script is:inline>
  // The Shop Talk live card: stamp the next Saturday's date chip, and make the calendar CTA
  // membership-aware (owner directive): a visitor goes to the join page; a signed-in member (the
  // SOW-030 extension identity signal, presentation-only, untrusted) gets the Google Calendar add
  // link. The feed ladder pager lives in the shared FeedList component.
  (function () {
    var d = new Date();
    d.setDate(d.getDate() + ((6 - d.getDay() + 7) % 7));
    var chip = document.querySelector('[data-shoptalk-day]');
    if (chip) chip.textContent = String(d.getDate());

    var cta = document.querySelector('[data-shoptalk-cta]');
    if (cta) {
      var calUrl = cta.getAttribute('data-calendar-url');
      function applyCta(signedIn) {
        if (signedIn && calUrl) {
          cta.setAttribute('href', calUrl);
          cta.setAttribute('target', '_blank');
          cta.setAttribute('rel', 'noopener');
        } else {
          cta.setAttribute('href', '/membership/');
          cta.removeAttribute('target');
          cta.removeAttribute('rel');
        }
      }
      function signalPresent() {
        try {
          var raw = document.documentElement.dataset.gbtiMember;
          return !!raw && JSON.parse(raw).authenticated === true;
        } catch (e) { return false; }
      }
      applyCta(signalPresent());
      document.addEventListener('gbti:identity', function (e) {
        applyCta(!!(e.detail && e.detail.authenticated === true));
      });
    }
  })();
</script>
</BaseLayout>

<script>
  // sow-192 (homepage v2): the tabbed feed. Everything shows the full blended feed (member content plus
  // public shares, seeded inline as before); the Articles / Products / Prompts / Shares tabs FILTER the
  // already-rendered rows in-page by data-kind, reusing the /feeds/ flatten-ladder pattern. The News tab
  // is a real link to /feeds/news/ (news is runtime worker data, not part of the static feed), so it
  // navigates rather than filtering; every tab keeps its /feeds/<narrow>/ href for no-JS and SEO. The
  // 3-state density toggle shares the 'gbti-feed-view' key with /feeds/ so the choice stays consistent.
  (() => {
    const view = document.querySelector<HTMLElement>('[data-hometabs]');
    if (!view) return;
    const list = view.querySelector<HTMLElement>('[data-feedlist]');
    const tabs = Array.from(view.querySelectorAll<HTMLElement>('[data-hometab]'));
    // The tab key is a plural narrow (articles/products/prompts/shares); a feed row's data-kind is the
    // singular item kind (article/product/prompt/share). Map the active narrow to the kind it selects.
    const NARROW_KIND: Record<string, string> = { articles: 'article', products: 'product', prompts: 'prompt', shares: 'share' };
    let active = 'all';

    const sections = document.querySelector<HTMLElement>('[data-home-sections]');

    function applyFilter() {
      const filtered = active !== 'all';
      const wantKind = NARROW_KIND[active] || '';
      view!.classList.toggle('feed-flat', filtered);
      // sow-192: the per-type section blocks show only on Everything; hide them under a content tab.
      if (sections) sections.hidden = filtered;
      // Flatten the ladder while a kind filter is active: lift the chunks' hidden attribute (Tailwind's
      // layered [hidden]{display:none!important} outranks author CSS, so this must be done in JS), and
      // restore it on return to Everything.
      list?.querySelectorAll<HTMLElement>('.feed-chunk').forEach((c) => {
        if (filtered) {
          if (c.hidden) { c.setAttribute('data-rehide', '1'); c.hidden = false; }
        } else if (c.hasAttribute('data-rehide')) {
          c.hidden = true;
          c.removeAttribute('data-rehide');
        }
      });
      const rows = list ? Array.from(list.querySelectorAll<HTMLElement>('[data-fi]')) : [];
      rows.forEach((r) => { r.hidden = filtered && r.getAttribute('data-kind') !== wantKind; });
    }

    function setActive(key: string) {
      active = key;
      tabs.forEach((t) => {
        const on = t.getAttribute('data-hometab') === key;
        t.classList.toggle('on', on);
        if (on) t.setAttribute('aria-current', 'true'); else t.removeAttribute('aria-current');
      });
      applyFilter();
      document.dispatchEvent(new Event('gbti:tab-changed')); // sow-192 Phase D: let personalize re-sync
    }

    tabs.forEach((t) => {
      t.addEventListener('click', (e) => {
        const key = t.getAttribute('data-hometab') || 'all';
        if (key === 'news') return; // the News tab navigates to /feeds/news/ (runtime news lives there)
        e.preventDefault();
        setActive(key);
      });
    });

    // Late-arriving news rows (peppered in after the async fetch) must respect the active tab, so a user
    // who switched to a content tab before news loaded does not suddenly see news rows appear.
    document.addEventListener('gbti:feed-updated', applyFilter);

    // Density: card / detailed / compact, sharing the '/feeds/' persisted key. Default is detailed (the
    // mockup's "list"); a stored choice overrides it.
    const KEY = 'gbti-feed-view';
    const dBtns = Array.from(view.querySelectorAll<HTMLButtonElement>('[data-feedview-density]'));
    function setDensity(v: string) {
      view!.setAttribute('data-view', v);
      dBtns.forEach((x) => { const on = x.getAttribute('data-feedview-density') === v; x.classList.toggle('on', on); x.setAttribute('aria-pressed', String(on)); });
      try { localStorage.setItem(KEY, v); } catch { /* private mode */ }
    }
    dBtns.forEach((b) => b.addEventListener('click', () => setDensity(b.getAttribute('data-feedview-density') || 'detailed')));
    try {
      const stored = localStorage.getItem(KEY);
      if (stored === 'compact' || stored === 'detailed' || stored === 'card') setDensity(stored);
    } catch { /* private mode */ }
  })();
</script>

<script>
  // sow-141 QA (2026-07-24): pepper the public worker news into the homepage feed, client-side. The
  // static build carries only member content (SEO); news is runtime data from the anonymous
  // signup-Worker endpoint, spliced in on a 2-members : 1-news rhythm so news never exceeds one third
  // of the blended feed. Rows mirror the /feeds/news renderer (same feed-item vocabulary, internal
  // /news/item/ deep links). A failed fetch or an empty feed leaves the page exactly as built.
  import { newsInsertionPlan } from '../lib/home-feed.mjs';
  (() => {
    const main = document.querySelector('main[aria-label="The network feed"]');
    const base = main?.getAttribute('data-signup-base') || '';
    const list = main?.querySelector('[data-feedlist]');
    if (!base || !list) return;
    const relTime = (epochS: number) => {
      const s = Math.max(0, Math.floor(Date.now() / 1000 - epochS));
      if (s < 60) return 'just now';
      const m = Math.floor(s / 60); if (m < 60) return m + 'm ago';
      const h = Math.floor(m / 60); if (h < 24) return h + 'h ago';
      const d = Math.floor(h / 24); if (d < 30) return d + 'd ago';
      if (d < 365) return Math.max(1, Math.round(d / 30)) + 'mo ago';
      return Math.max(1, Math.round(d / 365)) + 'y ago';
    };
    const el = (t: string, cls?: string, text?: string) => {
      const n = document.createElement(t);
      if (cls) n.className = cls;
      if (text !== undefined) n.textContent = text;
      return n;
    };
    const newsRow = (it: any) => {
      const art = el('article', 'feed-item news-row' + (it.image ? '' : ' nocover'));
      art.setAttribute('data-fi', '');
      art.setAttribute('data-kind', 'news'); // sow-192: so a content tab filter hides peppered news rows
      const main2 = el('div', 'feed-main');
      const meta = el('div', 'feed-meta');
      meta.append(
        el('span', 'kind-tag kt-news', 'news' + (it.source ? ' · ' + it.source : '')),
        el('span', 'tmeta', typeof it.publishedAt === 'number' ? relTime(it.publishedAt) : ''),
      );
      const detailHref = '/news/item/?g=' + encodeURIComponent(String(it.guid || '')) + (it.source ? '&s=' + encodeURIComponent(String(it.source)) : '');
      const h2 = el('h2', 'feed-title');
      const a = el('a', undefined, String(it.title || 'Untitled'));
      a.setAttribute('href', detailHref);
      h2.append(a);
      main2.append(meta, h2);
      if (it.summary) {
        const sum = String(it.summary).trim();
        main2.append(el('p', 'feed-ex', /[.!?]["')\]]?$/.test(sum) ? sum : sum + '...'));
      }
      const foot = el('div', 'feed-foot');
      foot.append(el('span', 'fsp'));
      main2.append(foot);
      art.append(main2);
      const cover = el('a', 'feed-cover' + (it.image ? '' : ' feed-cover-fb'));
      cover.setAttribute('href', detailHref);
      cover.setAttribute('aria-hidden', 'true');
      cover.setAttribute('tabindex', '-1');
      const img = document.createElement('img');
      const imgUrl = it.image ? String(it.image).replace(/&#0*38;/g, '&').replace(/&amp;/g, '&') : '';
      img.src = imgUrl || '/brand/feature/feature-category.png';
      img.alt = '';
      img.loading = 'lazy';
      img.decoding = 'async';
      img.addEventListener('error', () => {
        img.src = '/brand/feature/feature-category.png';
        cover.classList.add('feed-cover-fb');
      }, { once: true });
      cover.append(img);
      art.append(cover);
      return art;
    };
    // sow-192: the dedicated "Latest news" section is filled from this same fetch (no second request), and
    // removed entirely when the feed is empty or unavailable so it never lingers on "Loading".
    const lnSection = document.querySelector('[data-latest-news]');
    const lnList = document.querySelector('[data-latest-news-list]');
    const dropLatestNews = () => { if (lnSection) lnSection.remove(); };
    fetch(base + '/news/feed?limit=60')
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error('bad status'))))
      .then((data) => {
        const items = Array.isArray(data?.items) ? data.items : [];
        if (!items.length) { dropLatestNews(); return; }
        // Fill the Latest news section with the freshest items (each newsRow() is a fresh node).
        if (lnList) {
          const chunk = el('div', 'feed-chunk');
          items.slice(0, 6).forEach((it: any) => chunk.append(newsRow(it)));
          lnList.replaceChildren(chunk);
        }
        // Pepper news into the main blended feed (existing behavior).
        const rows = Array.from(list.querySelectorAll('.feed-chunk [data-fi]'));
        const plan = newsInsertionPlan(rows.length, items.length);
        plan.forEach((pos, i) => rows[pos]?.after(newsRow(items[i])));
        // sow-192: let the tabbed-feed filter re-apply so late news rows respect the active content tab.
        document.dispatchEvent(new Event('gbti:feed-updated'));
      })
      .catch(() => { dropLatestNews(); /* news is optional garnish; the built feed stands alone */ });
  })();
</script>

<script>
  // sow-192 Phase D: apply the member's Personalize FILTER to the Everything feed, client-side. The modal
  // (PersonalizeModal) dispatches `gbti:personalize` with the current settings; this hides feed rows that do
  // not pass (scope 'only followed members', hide-read, mix-shares-off), keeping the newest-first order (the
  // most-discussed reorder + tag boost are a documented follow-up). Personalization applies ONLY on the
  // Everything tab; the per-kind tab filter owns the others. Signed-out visitors never trigger this (the
  // modal only emits after a signed-in load), so the default feed is untouched. Read-state is per-device
  // (localStorage), set when a member opens a feed item.
  import { personalizeOrder } from '../lib/home-feed.mjs';
  (() => {
    const view = document.querySelector<HTMLElement>('[data-hometabs]');
    const list = view?.querySelector<HTMLElement>('[data-feedlist]');
    if (!view || !list) return;
    const READ = 'gbti-read';
    let settings: any = null;

    const activeTab = () => view.querySelector('.feed-tab.on')?.getAttribute('data-hometab') || 'all';
    const isActive = (s: any) => !!s && (s.scope === 'followed' || s.rules?.hideRead || s.rules?.sharesInline === false);

    function apply() {
      const onAll = activeTab() === 'all';
      // sow-192: keep the feed caption HONEST. The feed is newest-first unless the member has actually
      // personalized the Everything tab (isActive), so the "Curated by..." wording only shows when that is
      // true; a member who has followed nothing keeps "Newest first". Bound to the same signal as the re-rank.
      const note = document.querySelector('[data-feed-note]');
      if (note) note.textContent = (onAll && isActive(settings))
        ? 'Curated by the categories and tags you follow, newest first'
        : 'Newest first';
      // Always clear our own hides first, so switching tabs / clearing settings restores cleanly. We never
      // touch rows the tab filter hid (it uses r.hidden without our marker).
      list!.querySelectorAll<HTMLElement>('[data-fi][data-pz-hidden]').forEach((r) => { r.hidden = false; r.removeAttribute('data-pz-hidden'); });
      if (!onAll || !isActive(settings)) return;
      // Flatten so filtered rows across chunks all evaluate (mirrors the tab filter).
      list!.querySelectorAll<HTMLElement>('.feed-chunk').forEach((c) => { if (c.hidden) { c.setAttribute('data-rehide', '1'); c.hidden = false; } });
      view!.classList.add('feed-flat');
      let read = new Set<string>();
      try { read = new Set(JSON.parse(localStorage.getItem(READ) || '[]')); } catch { /* private mode */ }
      const rows = Array.from(list!.querySelectorAll<HTMLElement>('[data-fi]'));
      const desc = rows.map((r, i) => ({
        index: i,
        kind: r.getAttribute('data-kind') || '',
        author: r.getAttribute('data-author') || '',
        tags: (r.getAttribute('data-tags') || '').split(' ').filter(Boolean),
        comments: Number(r.getAttribute('data-comments') || 0),
        date: rows.length - i, // rows are server-rendered newest-first; keep that order
        read: read.has(r.querySelector('.feed-title a')?.getAttribute('href') || ''), // the ITEM link, not the author link
      }));
      const visible = new Set(personalizeOrder(desc, settings));
      rows.forEach((r, i) => { const show = visible.has(i); r.hidden = !show; if (!show) r.setAttribute('data-pz-hidden', '1'); });
    }

    document.addEventListener('gbti:personalize', (e: any) => { settings = e.detail; apply(); });
    document.addEventListener('gbti:tab-changed', apply);
    document.addEventListener('gbti:feed-updated', apply); // late news rows

    // Read beacon: mark a feed item read when the member OPENS it (clicks the title or cover, not the author
    // or meta links), keyed on the item's title link so it matches the read-check above.
    list.addEventListener('click', (e) => {
      const row = (e.target as HTMLElement)?.closest('[data-fi]');
      if (!row || !(e.target as HTMLElement)?.closest('.feed-title, .feed-cover')) return;
      const href = row.querySelector('.feed-title a')?.getAttribute('href') || '';
      if (!href || href.startsWith('#')) return;
      try { const s = new Set(JSON.parse(localStorage.getItem(READ) || '[]')); s.add(href); localStorage.setItem(READ, JSON.stringify([...s].slice(-500))); } catch { /* private mode */ }
    });
  })();
</script>

<script>
  // sow-192 Phase C: the signed-in homepage surfaces. Gated by the sow-158 member signal (member-signal.ts,
  // hydrated by BaseLayout from the httpOnly session cookie; the token never reaches page JS). Signed-out /
  // no-JS visitors never see these (the containers ship [hidden] and client-ui is imported LAZILY only after
  // the first signed-in signal). Mirrors the proven /account mount (account.astro). The composer self-gates
  // by membership; the header nav swap is sow-187, not here.
  import { onMemberSignal, currentIdentity, readMemberSignal } from '../lib/member-signal';
  (() => {
    const signedInEls = Array.from(document.querySelectorAll<HTMLElement>('[data-home-signedin]'));
    // The composer BAR (data-home-creator) is CREATOR-gated (the mockup shows it only in the Content Creator
    // state). sow-185 now surfaces the resolved paid tier on the member signal, so the gate reads
    // s.paidTier==='creator' (a superadmin/staff resolves to creator server-side, so no separate role check).
    // Fail-closed: paidTier is 'none' when unresolvable / an older Worker, so the bar stays hidden by default.
    // This is UNTRUSTED presentation state; the real creator gate stays server-side (authorizeCreator).
    const creatorEls = Array.from(document.querySelectorAll<HTMLElement>('[data-home-creator]'));
    // The signed-out join / "start your free trial" cards (the rail promo + the bottom band) hide for a
    // signed-in member (sow-192 QA: the trial CTA is not for members/creators; sow-185 retires the trial).
    const joinCards = Array.from(document.querySelectorAll<HTMLElement>('[data-home-joincard]'));
    if (!signedInEls.length && !creatorEls.length) return;
    let mounted = false;

    async function mountComposer(s: any) {
      if (mounted) return;
      mounted = true;
      const signupBase = document.documentElement.dataset.signupBase || '';
      const { createWorkbenchClient } = await import('../lib/workbench-client');
      const { setClient } = await import('../../client-ui/src/base.mjs');
      const adapter = createWorkbenchClient({ signupBase, login: String(s.login), githubId: s.githubId != null ? String(s.githubId) : null });
      setClient(adapter);
      // Defining the element upgrades the <gbti-share-composer> inside HomeShareModal; it loads its status on
      // connect (the client is already set), then renders the four-step wizard on the setClient fan-out.
      await import('../../client-ui/src/elements/gbti-share-composer.mjs');
    }

    function render(s: any) {
      const signedIn = !!(s && s.login);
      const creator = signedIn && s.paidTier === 'creator'; // sow-185: fail-closed to 'none'; staff resolves to creator
      signedInEls.forEach((el) => { el.hidden = !signedIn; });
      creatorEls.forEach((el) => { el.hidden = !creator; });
      joinCards.forEach((el) => { el.hidden = signedIn; });
      if (creator) {
        // Point the bar avatar at the member's GitHub avatar (same convention as the header).
        document.querySelectorAll<HTMLImageElement>('.hsb-av').forEach((img) => {
          img.src = 'https://github.com/' + encodeURIComponent(String(s.login)) + '.png?size=68';
          img.alt = '@' + String(s.login);
        });
        mountComposer(s); // load the client-ui composer only for a Creator (who can actually publish a share)
      }
    }

    render(currentIdentity(readMemberSignal()));
    onMemberSignal(render); // BaseLayout invokes hydrateMemberSignal(); the cookie member arrives here
  })();
</script>

<script>
  // sow-224: after a Share is posted from the homepage composer (or on load from the session store), prepend an
  // honest "in the publishing queue" stub into the homepage feed until the published Share lands (a public Share
  // only; a members Share is queued in the member stream on /account/).
  import { initFeedPendingStubs } from '../lib/feed-pending-stub';
  initFeedPendingStubs();
</script>
