---
// sow-158: a STUB for the site admin surface. Admin tools (roster, bans, roles, moderation) live in the browser
// extension today (SOW-036/038); the native site surface is deferred to sow-161. This page is a gated placeholder
// the header avatar menu's "Admin tools" points at, so a staff member on the cookie session lands somewhere honest
// instead of a dead relay. noindex: not a public page.
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Admin tools" description="GBTI Network admin." noindex={true}>
  <section class="band">
    <div class="wrap adm-wrap">
      {/* pre-hydration / non-staff fallback (static SSG has no request-time role). Hidden for staff by the script. */}
      <div class="sec-head center" data-admin-gate>
        <span class="itile"><svg viewBox="0 0 24 24"><use href="#ico-id"/></svg></span>
        <h1 class="h1 mt24">Checking access&hellip;</h1>
      </div>

      <div class="sec-head center" data-admin-body hidden>
        <span class="itile"><svg viewBox="0 0 24 24"><use href="#ico-id"/></svg></span>
        <h1 class="h1 mt24">Admin tools</h1>
        <p class="lead">
          Moderation and governance (member roster, bans, roles, and content remediation) run in the GBTI browser
          extension for now. A native admin surface on gbti.network is planned. Use the extension to manage the
          co-op today; this page will grow into the full toolset.
        </p>
        <div class="adm-actions mt24">
          <a href="/extension/" class="btn btn-primary">Get the extension <svg class="ar" viewBox="0 0 24 24" width="18" height="18"><use href="#ico-arrow"/></svg></a>
          <a href="/workbench/" class="btn btn-ghost">Back to your WorkBench</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { onMemberSignal, currentIdentity, readMemberSignal } from '../lib/member-signal';
    const RANK: Record<string, number> = { member: 0, moderator: 1, admin: 2, superadmin: 3 };
    const gate = document.querySelector('[data-admin-gate]');
    const body = document.querySelector('[data-admin-body]');
    let settled = false;
    function render(s) {
      const rank = RANK[s?.role ?? 'member'] ?? 0;
      // Staff (moderator+) see the stub; a signed-out or non-staff member is redirected to their account. Wait for
      // the cookie hydration (which now carries the role) before redirecting, so a staff member is not bounced.
      if (s && s.login && rank >= RANK.moderator) {
        settled = true;
        if (gate) gate.hidden = true;
        if (body) body.hidden = false;
      }
    }
    render(currentIdentity(readMemberSignal()));
    onMemberSignal(render); // BaseLayout hydrates the cookie session; the role arrives here
    // If, after hydration, no staff identity resolved, send the visitor to their account (fail closed).
    setTimeout(() => { if (!settled) location.replace('/account/'); }, 4000);
  </script>

  <style>
    .adm-wrap { max-width: 560px; }
    .adm-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  </style>
</BaseLayout>
