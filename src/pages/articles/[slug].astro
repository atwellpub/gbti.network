---
// sow-179 Phase 2: this page resolves which of the three article layouts renders the post, then stays thin.
// ContentFooter + the article-only closing blocks (OpenHistory / RelatedPosts / ContributionCredits /
// FavoritedBy) are composed once here and slotted into every layout's "closing" slot, so a layout may
// reorder them (Journal moves FavoritedBy into its rail) but never re-implements them.
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/blog/ArticleCard.astro';
import ArticleEditorial from '../../components/blog/ArticleEditorial.astro';
import ArticleJournal from '../../components/blog/ArticleJournal.astro';
import RelatedPosts from '../../components/blog/RelatedPosts.astro';
import ContributionCredits from '../../components/blog/ContributionCredits.astro';
import OpenHistory from '../../components/blog/OpenHistory.astro';
import ContentFooter from '../../components/ContentFooter.astro';
import EditHooks from '../../components/EditHooks.astro';
import TouchSignal from '../../components/TouchSignal.astro';
import { refCodeForAuthor } from '../../lib/referral';
import { defaultFeatureImage } from '../../lib/feature-image';
import FavoritedBy from '../../components/FavoritedBy.astro'; // SOW-114: the opt-in favoriter list
import { aliasSlugsOf } from '../../lib/content-index.mjs'; // SOW-112: pre-rename slugs for count/discussion aliasing
import { hasPublicPage, isStub as isStubFn } from '../../lib/content';
import { buildAvatarIndex, avatarStack } from '../../lib/avatars';
import { buildArticleToc } from '../../lib/article-page.mjs';

export async function getStaticPaths() {
  const posts = (await getCollection('post')).filter(hasPublicPage);
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

const { post } = Astro.props;
const d = post.data;
const { Content, headings } = await render(post);
const stub = isStubFn(post);
const postUrl = new URL(`/articles/${d.slug}/`, Astro.site ?? 'https://gbti.network').href;
const toc = buildArticleToc(headings, { hasBody: !stub, hasDiscussion: true });

const avatarIndex = buildAvatarIndex(await getCollection('profile'));
const stack = avatarStack({
  author: d.author,
  contributors: d.contributors,
  comments: await getCollection('comment'),
  targetType: 'post',
  targetSlug: d.slug,
  index: avatarIndex,
});

// sow-179/sow-183: the ?? fallback means an unrecognized value still renders, never 404s. Matches the
// schema's own default (src/content.config.ts) so an edge case here can never disagree with what a fresh
// post gets. Journal is the default (sow-183: "Journal rail should be the default of all articles too").
const LAYOUTS: Record<string, typeof ArticleCard> = { card: ArticleCard, editorial: ArticleEditorial, journal: ArticleJournal };
const Layout = LAYOUTS[d.layout] ?? ArticleJournal;
// Derived from the RESOLVED Layout, not re-checked against d.layout independently -- two separate
// derivations of the same value can silently disagree (e.g. an unrecognized d.layout falls back to
// ArticleJournal here but would stay false on a literal d.layout === 'journal' check), misrouting
// FavoritedBy into the wrong slot on whatever layout actually rendered.
const isJournal = Layout === ArticleJournal;
---
<BaseLayout title={d.title} description={d.excerpt} ogImage={d.coverImage?.src ?? defaultFeatureImage('post')} ogType="article">
  <Layout d={d} isStub={stub} postId={post.id} postUrl={postUrl} stack={stack} toc={toc}>
    <Content slot="body" />
    <ContentFooter slot="closing" type="post" slug={d.slug} author={d.author} publishedAt={d.publishedAt} aliases={aliasSlugsOf(d)} />
    <OpenHistory slot="closing" filePath={post.filePath} author={d.author} contributors={d.contributors} />
    <RelatedPosts slot="closing" post={post} />
    <ContributionCredits slot="closing" contributors={d.contributors} />
    {/* sow-183 QA fix: a slotted child's slot attribute must be a STATIC STRING, never any non-literal
        expression (`slot={expr}`, including a ternary's branches even when each branch is itself a literal
        string) -- a non-literal slot on ANY ONE child (confirmed by bisection against a stripped-down layout
        component, not assumed) silently dropped every OTHER statically-slotted sibling passed into the same
        parent: ContentFooter, OpenHistory, RelatedPosts and ContributionCredits all rendered empty. Two
        separate `{cond && <X slot="literal"/>}` expressions, each with its own literal slot, render correctly.
        Journal moves FavoritedBy into its own "rail" slot; every other layout keeps it in "closing" alongside
        the rest. */}
    {isJournal && <FavoritedBy slot="rail" type="post" slug={d.slug} aliases={aliasSlugsOf(d)} />}
    {!isJournal && <FavoritedBy slot="closing" type="post" slug={d.slug} aliases={aliasSlugsOf(d)} />}
  </Layout>
  <EditHooks type="post" owner={d.author} slug={d.slug} />
  <TouchSignal type="post" ownerId={refCodeForAuthor(d.author)} slug={d.slug} />
</BaseLayout>
