---
// Extracted from per-article markdown, where a "Follow the GBTI Network" block had been hand-copied into
// individual posts with links that had gone stale (twitter.com, an old YouTube channel URL, a dead Daily.dev
// short link, and a retired Hashnode publication). Rendered ONCE by ContentFooter for every content detail
// page, between the author box and the comments. The links are BOUND to src/lib/social.ts (the same
// SOCIAL_LINKS the footer uses), so there is one source of truth for them and no per-article copy to rot.
import { SOCIAL_LINKS } from '../lib/social';
---
<section class="follow-network" aria-label="Follow the GBTI Network">
  <h2 class="h3 fn-title">Follow the GBTI Network</h2>
  <p class="fn-sub">Get more content like this. Follow us on your favorite platforms for updates, news, and community discussions.</p>
  <div class="fn-social">
    {SOCIAL_LINKS.map((s) => (
      <a href={s.href} target="_blank" rel="noopener noreferrer" data-tooltip={s.label} aria-label={s.label}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
      </a>
    ))}
  </div>
</section>
<style>
  .follow-network {
    max-width: 820px;
    margin: 40px auto 0;
    padding: 28px 32px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-lg);
    background: var(--paper);
    text-align: center;
  }
  .fn-title { margin: 0 0 6px; }
  .fn-sub { color: var(--fg-mute); margin: 0 auto 18px; max-width: 52ch; }
  .fn-social { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .fn-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line-2);
    border-radius: 10px;
    color: var(--fg-mute);
    transition: color .15s ease, border-color .15s ease, background .15s ease;
  }
  .fn-social a:hover { color: var(--green); border-color: var(--green); background: var(--tint); }
  .fn-social a svg { display: block; }
  @media (max-width: 520px) { .follow-network { padding: 22px 18px; } }
</style>
