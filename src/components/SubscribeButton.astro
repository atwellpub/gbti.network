---
// A "Subscribe to activity" button (SOW-023). The INERT control: it ships in the public static build as
// `<gbti-subscribe data-gbti-username=..>` wrapping a button + a membership-gated dialog (the visitor path).
// On the static site there is no auth context, so a click opens the dialog with a join CTA. When a member's
// client/extension loads @gbti/client-ui, <gbti-subscribe> upgrades into a real follow toggle for effective-paid
// members (its Shadow DOM covers this light-DOM fallback); a trial/visitor falls back to the membership route.
// The followed `username` may be omitted at build (the prompts directory sets data-gbti-username from JS).
interface Props {
  name?: string; // who you would be subscribing to, for the dialog copy
  username?: string; // the followee's member username (the follow target); set dynamically when absent
  variant?: 'primary' | 'ghost' | 'white';
}
const { name = 'this member', username, variant = 'primary' } = Astro.props;
---
<gbti-subscribe class="subscribe-wrap" data-gbti-region="subscribe" data-gbti-username={username} style="display:inline-flex">
  <button type="button" class={`btn btn-${variant} subscribe-btn`} data-subscribe>
    <svg viewBox="0 0 24 24" width="16" height="16" style="margin-right:6px"><use href="#ico-mega"/></svg>
    Subscribe to activity
  </button>
  <dialog class="subscribe-modal" data-subscribe-modal aria-label="Subscribe to member activity">
    <div class="sm-card">
      {/* State 1 (default): no identity at all -> the become-a-member nudge. */}
      <div data-sub-state="join">
        <p class="eyebrow" style="color:var(--green-700)">Member feature</p>
        <h3 class="h3 mt8" data-subscribe-title>Subscribe to {name}</h3>
        <p class="body mt12" style="color:var(--fg-soft)">
          Activity subscriptions are available to GBTI Network members. Join to follow members and get
          their latest posts, products, prompts, and shares in your feed.
        </p>
        <div class="sm-actions mt24">
          <a href="/membership/" class="btn btn-primary">Become a member</a>
          <button type="button" class="btn btn-ghost" data-signin>Already a member? Sign in</button>
          <button type="button" class="btn btn-ghost" data-subscribe-close>Maybe later</button>
        </div>
      </div>
      {/* State 2: a signed-in identity (SOW-030 signal or the signup hint) but the control never upgraded,
          meaning there is no active WEBSITE session on this page -> sign in. SOW-186 C1: post-SOW-158 the follow
          toggle upgrades for a signed-in WEBSITE member too, so this is a sign-in nudge, not extension-required.
          The site sign-in is install-aware (SOW-019 SigninModal): it routes an extension user to the extension. */}
      <div data-sub-state="signin" hidden>
        <p class="eyebrow" style="color:var(--green-700)">Sign in to follow</p>
        <h3 class="h3 mt8">Sign in to follow</h3>
        <p class="body mt12" style="color:var(--fg-soft)">
          Sign in to follow this member and get their latest posts, products, prompts, and shares in your feed.
        </p>
        <div class="sm-actions mt24">
          <button type="button" class="btn btn-primary" data-signin>Sign in</button>
          <button type="button" class="btn btn-ghost" data-subscribe-close>Maybe later</button>
        </div>
      </div>
    </div>
  </dialog>
</gbti-subscribe>

<style>
  /* margin:auto + fit-content height re-centers the modal: Tailwind preflight resets margin:0 on every
     element, which clobbers the UA dialog centering and pins it top-left. */
  .subscribe-modal { border: 0; padding: 0; border-radius: var(--r-lg); max-width: 440px; width: calc(100vw - 32px); background: transparent; margin: auto; height: fit-content; max-height: calc(100dvh - 32px); }
  .subscribe-modal::backdrop { background: rgba(15, 14, 18, .55); backdrop-filter: blur(2px); }
  .subscribe-modal .sm-card { background: var(--paper); color: var(--fg); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 28px; box-shadow: var(--sh-lg); }
  .subscribe-modal .sm-actions { display: flex; flex-wrap: wrap; gap: 12px; }
</style>

<script>
  // SOW-186 C1: SubscribeButton is the inert follow control. It upgrades three ways:
  //  1) EXTENSION member: the SOW-030 signal + relay follow into the extension (unchanged).
  //  2) WEBSITE member (post-SOW-158): a cookie session upgrades <gbti-subscribe> into a live follow toggle on
  //     the site itself (setClient + import the element), so the dialog never opens for them.
  //  3) Everyone else: the dialog picks its state at open time - a visitor with no identity gets the join
  //     nudge; an identity with no active website session gets the sign-in nudge (install-aware SigninModal).
  import { onMemberSignal, currentIdentity, readMemberSignal } from '../lib/member-signal';

  // Read a non-HttpOnly cookie (the gbti_csrf double-submit token); its presence is the cheap "there is a web
  // session" signal the gated pages already use, with no network. (Same helper Comments.astro uses.)
  function readCookie(name: string): string | null {
    for (const part of document.cookie.split(';')) {
      const eq = part.indexOf('=');
      if (eq >= 0 && part.slice(0, eq).trim() === name) return part.slice(eq + 1).trim() || null;
    }
    return null;
  }
  function hasIdentity(): boolean {
    if (document.documentElement.dataset.gbtiMember) return true;
    try { return !!localStorage.getItem('gbti_hello'); } catch { return false; }
  }
  document.querySelectorAll('.subscribe-wrap').forEach((wrap) => {
    const btn = wrap.querySelector('[data-subscribe]');
    const dlg = wrap.querySelector('[data-subscribe-modal]') as HTMLDialogElement | null;
    if (!btn || !dlg) return;
    btn.addEventListener('click', () => {
      // With the extension installed AND a signed-in member, never show the dialog; relay into the extension.
      // (The upgraded shadow toggle normally covers this path; this is the fallback when it has not.) SOW-143:
      // relay to the member's in-extension profile detail view so the follow lands on the RIGHT member; the
      // username may be absent, so fall back to the workspace Subscriptions tab.
      const de = document.documentElement.dataset;
      if (de.gbtiExtension && de.gbtiMember) {
        const u = ((wrap as HTMLElement).dataset.gbtiUsername || '').trim().toLowerCase();
        const ok = /^[a-z0-9](?:-?[a-z0-9]){0,38}$/.test(u);
        const detail = ok
          ? { page: 'newtab.html', hash: `tab=member&member=${encodeURIComponent(u)}` }
          : { page: 'workspace.html', hash: 'tab=subs' };
        document.dispatchEvent(new CustomEvent('gbti:open', { detail }));
        return;
      }
      const signinNeeded = hasIdentity();
      dlg.querySelectorAll('[data-sub-state]').forEach((s) => {
        (s as HTMLElement).hidden = s.getAttribute('data-sub-state') !== (signinNeeded ? 'signin' : 'join');
      });
      dlg.showModal();
    });
    dlg.querySelectorAll('[data-subscribe-close]').forEach((c) => c.addEventListener('click', () => dlg.close()));
    // A [data-signin] control inside the dialog: close this dialog; the global SigninModal (BaseLayout) opens
    // the install-aware sign-in on the same click via its delegated [data-signin] listener.
    dlg.querySelectorAll('[data-signin]').forEach((c) => c.addEventListener('click', () => dlg.close()));
    // Click on the backdrop (outside the card) closes the dialog.
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  });

  // Upgrade <gbti-subscribe> for a signed-in WEBSITE member (a real cookie session), mirroring Comments.astro.
  // REUSES the header's cached cookie hydration (no extra /membership/status call). An anonymous visitor
  // resolves to null, nothing is imported, and the inert dialog fallback stays, so their page weight is unchanged.
  let upgraded = false;
  async function upgradeFollows(signal: any) {
    if (!signal || !signal.login) return; // signed out / not yet resolved -> leave the inert fallback
    // Hide the follow control on the member's OWN content (no "follow yourself"). Site-scoped guard: the
    // element itself is host-agnostic, but here the signed-in login is known.
    const mine = String(signal.login).toLowerCase();
    document.querySelectorAll('.subscribe-wrap').forEach((wrap) => {
      if (((wrap as HTMLElement).dataset.gbtiUsername || '').trim().toLowerCase() === mine) (wrap as HTMLElement).style.display = 'none';
    });
    if (upgraded || !readCookie('gbti_csrf')) return; // an extension-only signal has no web session to authenticate
    upgraded = true;
    const signupBase = document.documentElement.dataset.signupBase || '';
    const { createWorkbenchClient } = await import('../lib/workbench-client');
    const { setClient } = await import('../../client-ui/src/base.mjs');
    setClient(createWorkbenchClient({ signupBase, login: String(signal.login), githubId: signal.githubId != null ? String(signal.githubId) : null }));
    await import('../../client-ui/src/elements/gbti-subscribe.mjs');
  }
  upgradeFollows(currentIdentity(readMemberSignal())); // extension/cookie signal, if present, before hydration
  onMemberSignal(upgradeFollows);                      // the winning cookie member arrives here once hydrated
</script>
