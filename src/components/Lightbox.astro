---
// SOW-175: a site-wide image lightbox. A single hidden <dialog> plus one delegated script, rendered once per
// page via BaseLayout. Inert until an image is clicked, so it costs effectively nothing on image-less pages.
//
// It wires two kinds of trigger:
//   1. Every body image (`.prose-gbti img`) becomes zoom-in clickable, site-wide, across all content types
//      that render through the shared Prose renderer (articles, products, prompts, generic pages, the
//      workbench preview). A linked body image is left alone so its link still works.
//   2. Any element carrying `data-lightbox` opts in explicitly; `data-lightbox-group="<key>"` groups triggers
//      into one gallery with prev/next (the product screenshot grid + carousel use this). `data-full` names
//      the full-resolution source; `data-cap` an optional caption.
//
// Native <dialog> gives Esc-to-close and focus handling for free; backdrop click and arrow-key navigation are
// added. No external library, theme-aware, self-contained.
---
<dialog id="gbti-lightbox" class="lb" aria-label="Image viewer" data-lightbox-root>
  <button type="button" class="lb-x" data-lb-close aria-label="Close">
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
  </button>
  <button type="button" class="lb-nav lb-prev" data-lb-prev aria-label="Previous image" hidden>
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <figure class="lb-fig">
    <img class="lb-img" data-lb-img alt="" />
    <figcaption class="lb-cap" data-lb-cap></figcaption>
  </figure>
  <button type="button" class="lb-nav lb-next" data-lb-next aria-label="Next image" hidden>
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</dialog>

<style is:global>
  /* Body images invite a click everywhere Prose renders (SOW-175). A linked body image keeps its own cursor. */
  .prose-gbti img { cursor: zoom-in; }
  .prose-gbti a img { cursor: pointer; }
  /* Explicit opt-in triggers (the product galleries). */
  [data-lightbox] { cursor: zoom-in; }

  .lb {
    inset: 0; width: 100vw; height: 100vh; max-width: 100vw; max-height: 100vh;
    margin: 0; padding: 0; border: 0; background: transparent; overflow: hidden;
  }
  .lb::backdrop { background: rgba(20, 19, 24, .88); backdrop-filter: blur(3px); }
  .lb[open] { display: flex; align-items: center; justify-content: center; }
  .lb-fig { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .lb-img {
    max-width: 92vw; max-height: 86vh; width: auto; height: auto; object-fit: contain;
    border-radius: 8px; box-shadow: 0 12px 48px rgba(0, 0, 0, .55);
  }
  .lb-cap {
    color: rgba(255, 255, 255, .82); font-family: var(--f-mono, monospace); font-size: 13px;
    line-height: 1.5; max-width: 90vw; text-align: center;
  }
  .lb-cap:empty { display: none; }
  .lb-x, .lb-nav {
    position: fixed; display: inline-flex; align-items: center; justify-content: center;
    color: #fff; background: rgba(255, 255, 255, .12); border: 1px solid rgba(255, 255, 255, .22);
    border-radius: 999px; cursor: pointer; padding: 0; transition: background .15s, border-color .15s;
  }
  .lb-x:hover, .lb-nav:hover { background: rgba(255, 255, 255, .22); border-color: rgba(255, 255, 255, .4); }
  .lb-x { top: 14px; right: 16px; width: 42px; height: 42px; }
  .lb-nav { top: 50%; transform: translateY(-50%); width: 48px; height: 48px; }
  .lb-prev { left: 12px; }
  .lb-next { right: 12px; }
  .lb-nav[hidden] { display: none; }
  @media (max-width: 640px) {
    .lb-nav { width: 40px; height: 40px; }
    .lb-prev { left: 6px; }
    .lb-next { right: 6px; }
    .lb-img { max-width: 96vw; }
  }
</style>

<script>
  (() => {
    const dlg = document.getElementById('gbti-lightbox');
    if (!dlg || typeof dlg.showModal !== 'function') return; // no <dialog> support: body-image links still work
    const imgEl = dlg.querySelector('[data-lb-img]');
    const capEl = dlg.querySelector('[data-lb-cap]');
    const prevBtn = dlg.querySelector('[data-lb-prev]');
    const nextBtn = dlg.querySelector('[data-lb-next]');

    let group = [];
    let idx = 0;

    const proseImgs = () => Array.from(document.querySelectorAll('.prose-gbti img')).filter((im) => !im.closest('a'));
    const groupFor = (el) => {
      if (el.matches('[data-lightbox]')) {
        const key = el.getAttribute('data-lightbox-group');
        return key ? Array.from(document.querySelectorAll(`[data-lightbox][data-lightbox-group="${CSS.escape(key)}"]`)) : [el];
      }
      return proseImgs(); // a body image: the whole page's body images form one implicit gallery
    };
    const fullSrc = (el) => {
      if (el.dataset && el.dataset.full) return el.dataset.full;
      if (el.tagName === 'A' && el.getAttribute('href')) return el.href;
      const img = el.tagName === 'IMG' ? el : el.querySelector('img');
      return img ? (img.currentSrc || img.src) : '';
    };
    const capOf = (el) => {
      if (el.dataset && el.dataset.cap != null) return el.dataset.cap;
      const fig = el.closest && el.closest('figure');
      const fc = fig && fig.querySelector('figcaption');
      if (fc && fc.textContent.trim()) return fc.textContent.trim();
      const img = el.tagName === 'IMG' ? el : (el.querySelector && el.querySelector('img'));
      return img ? (img.getAttribute('alt') || '') : '';
    };

    const render = () => {
      const el = group[idx];
      if (!el) return;
      imgEl.src = fullSrc(el);
      const cap = capOf(el);
      imgEl.alt = cap || '';
      capEl.textContent = cap || '';
      const many = group.length > 1;
      prevBtn.hidden = !many;
      nextBtn.hidden = !many;
    };
    const go = (delta) => { if (group.length) { idx = (idx + delta + group.length) % group.length; render(); } };

    const open = (el) => {
      group = groupFor(el);
      idx = Math.max(0, group.indexOf(el));
      render();
      document.documentElement.style.overflow = 'hidden';
      dlg.showModal();
    };
    const close = () => { dlg.close(); };

    document.addEventListener('click', (e) => {
      const el = e.target.closest('[data-lightbox], .prose-gbti img');
      if (!el) return;
      if (el.matches('.prose-gbti img') && el.closest('a')) return; // linked body image: honor the link
      e.preventDefault();
      open(el);
    });

    prevBtn.addEventListener('click', () => go(-1));
    nextBtn.addEventListener('click', () => go(1));
    dlg.querySelector('[data-lb-close]').addEventListener('click', close);
    dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); }); // backdrop
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
    });
    dlg.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      imgEl.removeAttribute('src'); // free the decoded image
    });
  })();
</script>
