---
// sow-179 Phase 2: the "Card" article layout (layout: 'card'), extracted faithfully from the article detail
// page's only layout, with no visual change. Today's centered 820px reading card, name free for this full-page
// layout because the earlier feed/listing teaser of the same name is now ArticleTeaser.astro. Same props +
// slots contract as every article layout: d (the post's frontmatter data), isStub (already-resolved SOW-016
// Mode B boolean), a "body" slot carrying the rendered <Content />, and a "closing" slot carrying the shared
// + article-only components ([slug].astro composes and slots both in, this component never re-implements them).
import { Image } from 'astro:assets';
import Prose from './Prose.astro';
import VideoEmbed from '../VideoEmbed.astro';
import LockedBody from '../LockedBody.astro';
import ContentMeta from '../ContentMeta.astro';
import ContentActions from '../ContentActions.astro';
import { favoriteCount } from '../../lib/favorites';
import { aliasSlugsOf } from '../../lib/content-index.mjs';
import { breadcrumb } from '../../lib/taxonomy';
import { contentRepoPath } from '../../lib/content';

interface Props {
  d: any; // CollectionEntry<'post'>['data']
  isStub: boolean;
  postId: string; // post.id, for LockedBody's extension deep-link (SOW-112 QA parity with the product page)
  postUrl: string;
  stack: any[]; // avatarStack() result, ContentMeta's stacked byline avatars
  toc?: { id: string; label: string }[]; // [slug].astro passes this to every layout; Card has no rail, unused
}
const { d, isStub, postId, postUrl, stack } = Astro.props;
// sow-179: categories is one hierarchical path (house/taxonomy.yml), not independent chips -- render it as a
// single labelled breadcrumb like the product page already does, instead of merging its raw keys into the tag
// chip list. Tags stay a flat, free-form chip list.
const category = breadcrumb(d.categories).join(' › ');
// sow-183: the owner/superadmin Edit affordance, matching the product page's hero pill. The href is public
// build-time data; only visibility is a runtime decision (this component's own script block, below).
const editPath = contentRepoPath('post', d.author, d.slug);
const editHref = editPath ? `/workbench/#tab=post&edit=${encodeURIComponent(editPath)}` : null;
---
<section class="band" style="background:var(--paper-2)">
  <div class="wrap">
    <!-- Reading column, surfaced as a V3 paper card -->
    <article class="card mx-auto art-c-card" style="max-width:820px;padding:clamp(28px,5vw,56px)">
      {editHref && (
        <a href={editHref} target="_blank" rel="noopener" class="detail-edit" data-detail-edit data-detail-owner={d.author} hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          Edit
        </a>
      )}
      <header class="tcenter">
        {category && <p class="eyebrow">{category}</p>}
        <h1 data-gbti-region="title" class="h1 mt-8">{d.title}</h1>

        <div class="mt-20 flex col items-center g12">
          <ContentMeta author={d.author} publishedAt={d.publishedAt} stack={stack} center />
          <ContentActions type="post" slug={d.slug} title={d.title} url={postUrl} author={d.author} categories={d.categories} count={favoriteCount('post', d.slug, aliasSlugsOf(d))} />
        </div>

        {d.tags.length > 0 && (
          <ul class="mt-20 flex wrap-w justify-center g8" style="list-style:none;padding:0;margin-top:20px">
            {d.tags.map((t: string) => (
              <li class="chip">{t}</li>
            ))}
          </ul>
        )}
      </header>

      {d.video ? (
        <div class="mt-32"><VideoEmbed video={d.video} title={d.title} /></div>
      ) : d.coverImage ? (
        <>
          <Image src={d.coverImage} alt={d.coverAlt || d.title} width={1200} height={675} class="mt-32 w-full object-cover" style="border-radius:var(--r-lg)" />
          {d.coverAlt && <p class="mt-8 body-sm muted tcenter">{d.coverAlt}</p>}
        </>
      ) : null}

      <div class="mt-32" data-gbti-region="body">
        <Prose>
          {isStub ? <LockedBody encPath={d.encryptedBody} kind="body" readerPath={postId} readerType="post" /> : <slot name="body" />}
          {!isStub && d.encryptedBody && <LockedBody encPath={d.encryptedBody} kind="section" readerPath={postId} readerType="post" />}
        </Prose>
      </div>
    </article>

    <slot name="closing" />
  </div>
</section>

<script>
  // sow-183: the owner/superadmin Edit pill. See products/[slug].astro / src/lib/content.ts for the shared pattern.
  import { wireEditAffordance } from '../../lib/content';
  wireEditAffordance('[data-detail-edit]', 'data-detail-owner');
</script>
