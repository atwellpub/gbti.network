---
// SOW-019: install-aware sign-in. Any [data-signin] control opens this dialog, which detects the GBTI
// extension (via the content-script marker document.documentElement.dataset.gbtiExtension) and shows the
// right path: install + member benefits when absent, or "open the extension" guidance when present. No-JS
// falls back to the control's own href (the /membership/ benefits + registration page). Rendered once per
// page via BaseLayout.
import { extensionInstallUrl, extensionIsListed } from '../lib/extension';
const benefitsUrl = '/membership/';
---
<dialog id="gbti-signin-dialog" data-signin-dialog class="signin-dialog" data-install={extensionInstallUrl} data-listed={String(extensionIsListed)} aria-labelledby="signin-title">
  <div class="signin-card">
    <button type="button" class="signin-x" data-close aria-label="Close">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
    </button>

    {/* sow-158 Phase 2: web sign-in is the primary path (GitHub OAuth -> an httpOnly session, no extension needed);
        the extension is now an optional add-on for in-place editing/publishing. */}
    <div data-state="absent">
      <span class="itile"><svg viewBox="0 0 24 24"><use href="#ico-spark"/></svg></span>
      <h2 class="h3 mt12" id="signin-title">Join the GBTI co-op</h2>
      <p class="body-sm muted mt8">
        Saving, collecting, and following are member perks. Sign in with a free GitHub account to keep what you
        find, and become a member to comment, join the Discord, and unlock members-only content.
      </p>
      <div class="signin-actions mt20">
        <a class="btn btn-primary" href="/login/" data-web-signin>Sign in with GitHub</a>
        <a class="btn btn-ghost" href={benefitsUrl}>See membership options</a>
      </div>
      <p class="body-sm muted mt12" style="font-size:12.5px"><a href={extensionInstallUrl} data-install-link rel={extensionIsListed ? null : 'nofollow'}>Get the extension</a> to edit and publish your work in place.</p>
    </div>

    {/* Extension installed. sow-158 Phase 2 residual fix: web sign-in stays the PRIMARY path even here (it sets the
        httpOnly session the WorkBench + web member experience need; the extension's own sign-in sets only the
        display-only identity signal, not that cookie). The extension popup cannot be opened from a page, so its
        sign-in is offered as a secondary "edit in place" route via the toolbar icon. */}
    <div data-state="present" hidden>
      <span class="itile"><svg viewBox="0 0 24 24"><use href="#ico-github"/></svg></span>
      <h2 class="h3 mt12">Sign in to GBTI Network</h2>
      <p class="body-sm muted mt8">Sign in on the web to use your WorkBench and browse as a member. The GBTI extension is installed too: click its icon in your browser toolbar to also edit and publish your work in place.</p>
      <div class="signin-actions mt20">
        <a class="btn btn-primary" href="/login/" data-web-signin>Sign in on the web</a>
        {/* owner QA 2026-07-22: pages that declare a reader hash (data-gbti-reader-hash on their shell)
            get a direct open-in-the-extension action, so likes/saves route the member to the page's
            in-extension view instead of a dead end. Hidden when the page declares none. */}
        <button type="button" class="btn btn-ghost" data-open-in-extension hidden>Open this page in the extension</button>
        <a class="btn btn-ghost" href={benefitsUrl}>Member benefits</a>
      </div>
    </div>
  </div>
</dialog>

<script>
  (() => {
    const dialog = document.querySelector('[data-signin-dialog]') as HTMLDialogElement | null; // sow-158 residual #1: data-attr, not a guessable id
    if (!dialog) return;
    const absent = dialog.querySelector('[data-state="absent"]') as HTMLElement;
    const present = dialog.querySelector('[data-state="present"]') as HTMLElement;

    let installed = !!document.documentElement.dataset.gbtiExtension;
    const sync = () => {
      installed = !!document.documentElement.dataset.gbtiExtension;
      if (installed) document.documentElement.classList.add('has-gbti-ext');
      if (absent) absent.hidden = installed;
      if (present) present.hidden = !installed;
    };
    sync();
    // The content script sets the marker at document_idle; catch it if it lands after this runs.
    document.addEventListener('gbti:extension-ready', sync);

    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement)?.closest('[data-signin]');
      if (trigger) {
        if (typeof dialog.showModal !== 'function') return; // no <dialog> support: follow the href fallback
        e.preventDefault();
        sync();
        // sow-158 Phase 2: carry the current path into the web sign-in link so login returns the member here (the
        // Worker re-validates return_to to a same-site path). Omit it when already on /login. Both the absent AND
        // the present (extension-installed) states carry a [data-web-signin], so update every one.
        const rt = location.pathname + location.search + location.hash;
        const href = location.pathname.startsWith('/login') ? '/login/' : ('/login/?return_to=' + encodeURIComponent(rt));
        dialog.querySelectorAll('[data-web-signin]').forEach((el) => { (el as HTMLAnchorElement).href = href; });
        // owner QA 2026-07-22: surface the open-in-extension action when the page declares a reader hash.
        const openBtn = dialog.querySelector('[data-open-in-extension]') as HTMLElement | null;
        const readerHash = document.querySelector('[data-gbti-reader-hash]')?.getAttribute('data-gbti-reader-hash') || '';
        if (openBtn) openBtn.hidden = !(installed && readerHash);
        dialog.showModal();
        if (installed) document.dispatchEvent(new CustomEvent('gbti:request-signin'));
        return;
      }
      if ((e.target as HTMLElement)?.closest('[data-open-in-extension]')) {
        const readerHash = document.querySelector('[data-gbti-reader-hash]')?.getAttribute('data-gbti-reader-hash') || '';
        document.dispatchEvent(new CustomEvent('gbti:open', { detail: { page: 'newtab.html', hash: readerHash || undefined } }));
        dialog.close();
        return;
      }
      if ((e.target as HTMLElement)?.closest('[data-close]')) { dialog.close(); return; }
      if (e.target === dialog) dialog.close(); // backdrop click
    });
  })();
</script>

<style>
  .signin-dialog { border: none; border-radius: var(--r-lg); padding: 0; max-width: 440px; width: calc(100% - 32px);
    background: var(--paper); color: var(--fg); box-shadow: var(--sh-lg);
    /* margin:auto + fit-content height re-centers the modal (Tailwind preflight resets margin:0 on every
       element, clobbering the UA dialog centering and pinning it top-left). */
    margin: auto; height: fit-content; max-height: calc(100dvh - 32px); }
  .signin-dialog::backdrop { background: rgba(37, 35, 43, .55); backdrop-filter: blur(2px); }
  [data-theme="dark"] .signin-dialog { background: var(--ink-2); border: 1px solid var(--line-dark); }
  .signin-card { padding: 32px; position: relative; }
  .signin-x { position: absolute; top: 14px; right: 14px; display: inline-flex; padding: 6px; border: none;
    background: transparent; color: var(--fg-mute); cursor: pointer; border-radius: var(--r); }
  .signin-x:hover { background: var(--tint); color: var(--fg); }
  .signin-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .signin-actions .btn { flex: 1 1 auto; }
</style>
