---
// sow-192 QA (owner, 2026-08-07, v2): the homepage Prompts & Skills card. NO background image (the branded
// placeholder read weak); instead a clean, wide ONE-PER-ROW card led by the robot glyph (#ico-bot) on a brand
// tile, with the substance of the prompt beside it: category + title + the models it runs on + the "from the
// author" note (or the short description) + author and the favorite/save actions. The directory PromptCard is
// untouched.
import type { CollectionEntry } from 'astro:content';
import { authorDisplay, authorAvatar } from '../../lib/authors';
import { leafLabel, topKey } from '../../lib/taxonomy';
import { favoriteCount } from '../../lib/favorites';
import Avatar from '../Avatar.astro';
import FavoriteButton from '../FavoriteButton.astro';
import CollectionButton from '../CollectionButton.astro';

interface Props {
  prompt: CollectionEntry<'prompt'>;
  comments: CollectionEntry<'comment'>[];
  profiles: CollectionEntry<'profile'>[];
}
const { prompt, comments, profiles } = Astro.props;
const d = prompt.data;
const models = (d.targets ?? []).slice(0, 3);

// SOW-014 "from the author" note: the owner's published, public, authorNote-flagged comment for this prompt.
// Falls back to the short description so the card always says something about the prompt's power.
const note = comments.find(
  (c) =>
    c.data.targetType === 'prompt' &&
    c.data.targetSlug === d.slug &&
    c.data.author === d.author &&
    c.data.authorNote === true &&
    c.data.status === 'published' &&
    c.data.visibility === 'public',
);
const noteText = (note?.body ?? '')
  .replace(/```[\s\S]*?```/g, ' ')
  .replace(/[#>*_`~\[\]()]/g, '')
  .replace(/\s+/g, ' ')
  .trim();
const body = (noteText || d.shortDescription || '').slice(0, 220);

const profile = profiles.find((p) => p.data.username === d.author)?.data;
const authorName = profile?.displayName ?? authorDisplay(d.author);
const avatar = authorAvatar(d.author, profile?.avatar);
---
<article class="hp-row">
  <a class="hp-bot" href={`/prompts/${d.slug}/`} aria-hidden="true" tabindex="-1">
    <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-bot"/></svg>
  </a>
  <div class="hp-main">
    <div class="hp-metarow">
      <a class="hp-kind" href={`/prompts/?cat=${topKey(d.categories)}`}>{leafLabel(d.categories)}</a>
      {models.length > 0 && (
        <span class="hp-runs">
          <span class="hp-runs-l">Runs on</span>
          {models.map((m) => <a class="hp-model" href={`/prompts/?target=${encodeURIComponent(m)}`}>{m}</a>)}
        </span>
      )}
    </div>
    <h3 class="hp-title"><a href={`/prompts/${d.slug}/`}>{d.title}</a></h3>
    {body && <p class="hp-body">{body}</p>}
    <div class="hp-foot">
      <a class="hp-author" href={`/prompts/?author=${encodeURIComponent(d.author)}`}>
        <Avatar item={{ name: authorName, avatar }} class="hp-av" size={24} />
        <span>{authorName}</span>
      </a>
      <div class="hp-actions">
        <FavoriteButton targetType="prompt" targetSlug={d.slug} count={favoriteCount('prompt', d.slug)} size="sm" />
        <CollectionButton targetType="prompt" targetSlug={d.slug} size="sm" />
      </div>
    </div>
  </div>
</article>
