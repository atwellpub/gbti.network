---
// sow-192 (owner-elected 2026-08-10, "GBTI Homepage" design): the logged-out extension promo banner that sits
// between the pricing accordion and the feed. THEME-AWARE (owner request 2026-08-11): a clean white promo card
// in light mode, the near-black panel in dark mode; the `>_ gbti` terminal chip is themed too (a light tinted
// chip in light mode, the dark chip in dark). Shown to signed-out visitors ONLY: it carries the shared [data-home-joincard] hook, so the
// homepage mount script hides it for a signed-in member (same as the pricing accordion + join card). The whole
// banner links to the live Chrome Web Store listing. Presentation only. Light-first, [data-theme="dark"]
// overrides for dark (the header script always stamps an explicit data-theme, so no media query is needed).
import { EXTENSION } from '../../lib/extension';
---
<a
  class="xbn"
  href={EXTENSION.webStoreUrl}
  target="_blank"
  rel="noopener"
  data-home-joincard
  aria-label="Launch the Chrome Extension: add GBTI Network to Chrome"
>
  <span class="xbn-chip" aria-hidden="true">
    <span class="xbn-prompt">&gt;_</span><span class="xbn-word">gbti</span>
  </span>
  <span class="xbn-copy">
    <span class="xbn-title">Launch the Chrome Extension</span>
    <span class="xbn-eyebrow">Thanks for paying attention</span>
  </span>
  <span class="xbn-cta">
    <svg viewBox="0 0 48 48" width="20" height="20" aria-hidden="true">
      <circle cx="24" cy="24" r="23" fill="none" stroke="#fff" stroke-width="3"/>
      <circle cx="24" cy="24" r="9.4" fill="none" stroke="#fff" stroke-width="3"/>
      <path d="M43.9 12.6H24M13.9 18.7L4 35.9M34.1 29.4L24.2 46.6" stroke="#fff" stroke-width="3" stroke-linecap="round"/>
    </svg>
    Add to Chrome
  </span>
</a>

<style>
  /* Light-mode default: a clean white promo card that sits with the other rail/feed cards. */
  .xbn {
    display: flex;
    align-items: center;
    gap: 24px;
    margin: 18px 0;
    padding: 20px 26px;
    background: var(--paper);
    border: 1.5px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--sh-sm);
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .xbn:hover { border-color: rgba(31, 158, 95, 0.55); box-shadow: var(--sh); }
  .xbn[hidden] { display: none !important; } /* explicit display beats the UA [hidden] rule */

  /* Skewed terminal chip: >_ gbti. Light-mode default = a soft tinted chip; the dark chip is restored below. */
  .xbn-chip {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    background: var(--tint-warm);
    border: 1px solid var(--line-2);
    border-radius: 6px;
    transform: skewX(-11deg);
  }
  .xbn-prompt { font: 600 19px var(--f-mono); color: var(--green); transform: skewX(11deg); }
  .xbn-word { font: 500 15px var(--f-mono); color: var(--fg-mute); transform: skewX(11deg); }

  .xbn-copy { flex: 1; min-width: 0; }
  .xbn-title {
    display: block;
    font: 700 26px/1.1 var(--f-display);
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .xbn-eyebrow {
    display: block;
    margin-top: 6px;
    font: 500 10px var(--f-mono);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--fg-mute);
  }

  .xbn-cta {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 13px 24px;
    background: #1f9e5f;
    border-radius: 8px;
    color: #fff;
    font: 700 14px var(--f-body);
    white-space: nowrap;
    transition: background 0.15s ease;
  }
  .xbn:hover .xbn-cta { background: #23b06b; }
  .xbn-cta svg { display: block; flex: none; }

  /* Dark mode: restore the near-black promo panel from the design. The theme selector is wrapped in
     :global() so Astro scopes ONLY the trailing .xbn; without it Astro appends the component cid to the
     [data-theme] compound too, which then demands the cid on <html> and the rule never matches. */
  :global([data-theme="dark"]) .xbn {
    background: #141218;
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: none;
  }
  :global([data-theme="dark"]) .xbn:hover { border-color: rgba(31, 158, 95, 0.55); box-shadow: none; }
  :global([data-theme="dark"]) .xbn-chip { background: #232029; border-color: transparent; }
  :global([data-theme="dark"]) .xbn-prompt { color: #5fd49a; }
  :global([data-theme="dark"]) .xbn-word { color: #847f8d; }
  :global([data-theme="dark"]) .xbn-title { color: #f3f2f0; }
  :global([data-theme="dark"]) .xbn-eyebrow { color: #847f8d; }

  @media (max-width: 640px) {
    .xbn { flex-wrap: wrap; gap: 16px; }
    .xbn-copy { flex-basis: calc(100% - 90px); }
    .xbn-cta { width: 100%; justify-content: center; }
  }
</style>
