---
// sow-179: the reusable social-share icon row, extracted from the prompt detail page so every content type
// (post / product / prompt) shares the same control. buildShare (src/lib/share.ts) shapes the per-platform
// intent URLs. X / LinkedIn / Reddit / WhatsApp / SMS are intent links; Copy link is JS-driven (clipboard
// write + a brief "copied" state). Reddit is deliberate: it is where this audience already discusses GBTI
// content. WhatsApp and SMS are the messaging targets restored under sow-179 open question 4 (they carry the
// combined "lead title url" text, no hashtags). See .data/ops/share-ops and
// .data/sow/2_waiting_review/website/sow-179-article-switchable-layouts.md.
import { buildShare, type ShareType } from '../lib/share';

interface Props {
  type: ShareType; // 'post' | 'product' | 'prompt'
  title: string;
  url: string; // absolute, canonical URL
  categories?: string[];
  variant?: 'row' | 'rail'; // sow-179: 'rail' stacks vertically for the Editorial/Journal sticky action rail
}
const { type, title, url, categories = [], variant = 'row' } = Astro.props;
const share = buildShare({ type, title, url, categories });
---
<div class:list={['share-row', variant === 'rail' && 'share-rail']}>
  <a class="share-btn" href={share.x} target="_blank" rel="noopener" aria-label="Share on X" data-tooltip="Share on X">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
  </a>
  <a class="share-btn" href={share.linkedin} target="_blank" rel="noopener" aria-label="Share on LinkedIn" data-tooltip="Share on LinkedIn">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3Zm7 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95C21.4 8.75 22 11 22 14v7h-4v-6.2c0-1.5-.03-3.4-2.1-3.4-2.1 0-2.4 1.6-2.4 3.3V21h-4Z"/></svg>
  </a>
  <a class="share-btn" href={share.reddit} target="_blank" rel="noopener" aria-label="Share on Reddit" data-tooltip="Share on Reddit">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 11.2a2.2 2.2 0 0 0-3.7-1.6 10.8 10.8 0 0 0-5.4-1.7l.9-4.2 2.9.6a1.8 1.8 0 1 0 .2-1.4l-3.6-.8a.7.7 0 0 0-.8.5l-1.1 5.3a10.8 10.8 0 0 0-5.4 1.7A2.2 2.2 0 1 0 3.4 13c0 .2 0 .4.1.6-.1.4-.2.8-.2 1.2 0 3.4 3.9 6.2 8.7 6.2s8.7-2.8 8.7-6.2c0-.4-.1-.8-.2-1.2.9-.4 1.5-1.3 1.5-2.4ZM7.6 13.4a1.6 1.6 0 1 1 3.2 0 1.6 1.6 0 0 1-3.2 0Zm8.6 4.1c-1.1 1.1-3.2 1.2-3.8 1.2s-2.7-.1-3.8-1.2a.4.4 0 0 1 .6-.6c.7.7 2.2.9 3.2.9s2.5-.2 3.2-.9a.4.4 0 1 1 .6.6Zm-.2-2.5a1.6 1.6 0 1 1 0-3.2 1.6 1.6 0 0 1 0 3.2Z"/></svg>
  </a>
  <a class="share-btn" href={share.whatsapp} target="_blank" rel="noopener" aria-label="Share on WhatsApp" data-tooltip="Share on WhatsApp">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.334.101 11.892c0 2.096.549 4.14 1.595 5.945L0 24l6.335-1.652a12.062 12.062 0 005.71 1.44h.006c6.585 0 11.946-5.336 11.949-11.896 0-3.176-1.24-6.165-3.495-8.411"/></svg>
  </a>
  <a class="share-btn" href={share.sms} rel="noopener" aria-label="Share via SMS" data-tooltip="Share via SMS">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11.5a7.5 7.5 0 0 1-10.9 6.7L4 19.5l1.3-3.9A7.5 7.5 0 1 1 20 11.5Z"/></svg>
  </a>
  <button type="button" class="share-btn" data-copy-link data-url={url} aria-label="Copy link" data-tooltip="Copy link">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
  </button>
</div>

<style>
  .share-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .share-btn { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;
    border: 1.5px solid var(--line-2); border-radius: 50%; background: var(--paper); color: var(--fg-soft);
    cursor: pointer; transition: border-color .15s, color .15s, transform .15s; }
  .share-btn:hover { border-color: var(--ink); color: var(--ink); transform: translateY(-1px); }
  .share-btn.copied { border-color: var(--green); color: var(--green-700); }
  .share-btn svg { width: 14px; height: 14px; }
  /* Invariant: a 44px touch target even though the icon draws at 32px, so a coarse pointer never has to
     aim precisely. Mouse/trackpad users keep the tighter visual size. */
  @media (hover: none) and (pointer: coarse) {
    .share-btn { width: 44px; height: 44px; }
  }
  /* sow-179: the sticky action rail stacks these vertically as 38px rounded squares, matching Favorite/Save. */
  .share-rail { flex-direction: column; gap: 6px; }
  .share-rail .share-btn { width: 38px; height: 38px; border-radius: 7px; background: var(--paper-2); }
  @media (hover: none) and (pointer: coarse) {
    .share-rail .share-btn { width: 38px; height: 38px; }
  }
</style>

<script>
  // Copy link: clipboard write + a brief "copied" state. querySelectorAll covers every ShareRow instance on
  // the page (the component renders once per detail page today, but stays defensive).
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((b) => b.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(b.dataset.url ?? '');
      b.classList.add('copied');
      const prev = b.dataset.tooltip;
      b.dataset.tooltip = 'Copied!';
      setTimeout(() => { b.classList.remove('copied'); if (prev) b.dataset.tooltip = prev; }, 1500);
    } catch {}
  }));
</script>
